Cell[BoxData[{
 RowBox[{
  RowBox[{"sol1", "=", 
   RowBox[{"Monitor", "[", 
    RowBox[{
     RowBox[{"NDSolve", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"Psi", "'"}], "[", "t", "]"}], "==", 
          RowBox[{
           RowBox[{
            RowBox[{"UPathTmp", "'"}], "[", "t", "]"}], "*", 
           RowBox[{
            RowBox[{"PicardFuchsA", "[", 
             RowBox[{
              RowBox[{"N", "[", 
               RowBox[{
                RowBox[{"\[Lambda]Path", "[", "m0", "]"}], ",", "100"}], 
               "]"}], ",", 
              RowBox[{"UPathTmp", "[", "t", "]"}]}], "]"}], ".", 
            RowBox[{"Psi", "[", "t", "]"}]}]}]}], ",", 
         RowBox[{
          RowBox[{"Psi", "[", "0", "]"}], "==", "tmp"}]}], "}"}], ",", "Psi", 
       ",", 
       RowBox[{"{", 
        RowBox[{"t", ",", "0", ",", "1"}], "}"}], ",", 
       RowBox[{"WorkingPrecision", "->", "20"}], ",", 
       RowBox[{"MaxSteps", "->", 
        RowBox[{"10", "^", "6"}]}], ",", 
       RowBox[{"StepMonitor", ":>", 
        RowBox[{"(", 
         RowBox[{"tt", "=", "t"}], ")"}]}]}], "]"}], ",", " ", 
     RowBox[{"ProgressIndicator", "[", "tt", "]"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"tmp1", "=", 
  RowBox[{
   RowBox[{"Psi", "[", "1", "]"}], "/.", " ", 
   RowBox[{"First", "[", "sol1", "]"}]}]}]}], "Input",
