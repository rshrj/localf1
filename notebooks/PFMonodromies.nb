Cell[CellGroupData[{

Cell["Using ComputeTransition", "Section",
 CellChangeTimes->{{3.977816893639062*^9, 
  3.977816905329276*^9}},ExpressionUUID->"1b61154a-94fb-48c6-b29f-\
d6bee9d2f710"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"\[Lambda]Path", "[", "m_", "]"}], ":=", 
    RowBox[{
     RowBox[{
      RowBox[{"-", "1"}], "/", "4"}], 
     RowBox[{"Exp", "[", 
      RowBox[{"2", "Pi", " ", "I", " ", "m"}], "]"}]}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"rhs", "[", 
     RowBox[{"m_", ",", "uu_"}], "]"}], ":=", 
    RowBox[{"Evaluate", "@", 
     RowBox[{"Simplify", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"-", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"D", "[", 
            RowBox[{
             RowBox[{"MirrorCurveDelta", "[", 
              RowBox[{"\[Lambda]", ",", "u"}], "]"}], ",", "\[Lambda]"}], 
            "]"}], "/.", " ", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"\[Lambda]", "->", 
              RowBox[{"\[Lambda]Path", "[", "m", "]"}]}], ",", 
             RowBox[{"u", "->", "uu"}]}], "}"}]}], ")"}]}], "/", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"D", "[", 
           RowBox[{
            RowBox[{"MirrorCurveDelta", "[", 
             RowBox[{"\[Lambda]", ",", "u"}], "]"}], ",", "u"}], "]"}], "/.", 
          " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"\[Lambda]", "->", 
             RowBox[{"\[Lambda]Path", "[", "m", "]"}]}], ",", 
            RowBox[{"u", "->", "uu"}]}], "}"}]}], ")"}]}], "*", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"\[Lambda]Path", "'"}], "[", "m", "]"}], ")"}]}], "]"}]}]}], 
   ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"u0", "=", 
   RowBox[{"u", "/.", " ", 
    RowBox[{"Solve", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"MirrorCurveDelta", "[", 
        RowBox[{
         RowBox[{"\[Lambda]Path", "[", "0", "]"}], ",", "u"}], "]"}], "==", 
       "0"}], ",", "u"}], "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"labels", "=", 
    RowBox[{"{", 
     RowBox[{"2", ",", "1", ",", "4", ",", "3"}], "}"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"sol", "=", 
    RowBox[{"First", "@", 
     RowBox[{"Monitor", "[", 
      RowBox[{
       RowBox[{"NDSolve", "[", 
        RowBox[{
         RowBox[{"Join", "[", 
          RowBox[{
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{
                RowBox[{"Subscript", "[", 
                 RowBox[{"u", ",", "k"}], "]"}], "'"}], "[", "m", "]"}], "==", 
              RowBox[{"rhs", "[", 
               RowBox[{"m", ",", 
                RowBox[{
                 RowBox[{"Subscript", "[", 
                  RowBox[{"u", ",", "k"}], "]"}], "[", "m", "]"}]}], "]"}]}], 
             ",", 
             RowBox[{"{", 
              RowBox[{"k", ",", "4"}], "}"}]}], "]"}], ",", 
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"Subscript", "[", 
                RowBox[{"u", ",", "k"}], "]"}], "[", "0", "]"}], "==", 
              RowBox[{"u0", "[", 
               RowBox[{"[", "k", "]"}], "]"}]}], ",", 
             RowBox[{"{", 
              RowBox[{"k", ",", "4"}], "}"}]}], "]"}]}], "]"}], ",", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"Subscript", "[", 
            RowBox[{"u", ",", "k"}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"k", ",", "4"}], "}"}]}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"m", ",", "0", ",", "4"}], "}"}], ",", " ", 
         RowBox[{"WorkingPrecision", "->", "60"}], ",", " ", 
         RowBox[{"MaxSteps", "->", 
          RowBox[{"10", "^", "7"}]}], ",", 
         RowBox[{"StepMonitor", ":>", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"mGlobal", "=", "m"}], ";"}], ")"}]}]}], "]"}], ",", " ", 
       
       RowBox[{"ProgressIndicator", "[", 
        RowBox[{"mGlobal", "/", "4"}], "]"}]}], "]"}]}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"us", "[", "m_", "]"}], ":=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"Subscript", "[", 
        RowBox[{"u", ",", "k"}], "]"}], "[", "m", "]"}], "/.", " ", "sol"}], ",", 
     RowBox[{"{", 
      RowBox[{"k", ",", "4"}], "}"}]}], "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.977585945543066*^9, 3.977585946831553*^9}, {
  3.977642644554347*^9, 3.977642676243545*^9}, {3.977642906887182*^9, 
