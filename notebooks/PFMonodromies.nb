 RowBox[{
  RowBox[{"tmp", "=", 
   RowBox[{"SystemMatrix", "[", 
    RowBox[{
     RowBox[{"F1Series", "[", 
      RowBox[{
       RowBox[{"N", "[", 
        RowBox[{
         RowBox[{"\[Lambda]Path", "[", "m0", "]"}], ",", "100"}], "]"}], ",", 
       " ", 
       RowBox[{"UPathTmp", "[", "0", "]"}], ",", "256", ",", "4"}], "]"}], ",", 
     RowBox[{"N", "[", 
      RowBox[{
       RowBox[{"\[Lambda]Path", "[", "m0", "]"}], ",", "100"}], "]"}], ",", 
