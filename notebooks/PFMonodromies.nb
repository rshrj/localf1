   RowBox[{"ComputeTransition", "[", 
    RowBox[{"\[Lambda]_", ",", " ", "upath_", ",", "SystMat_"}], "]"}], ":=", 
   
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"sol", ",", "Psi", ",", "mon"}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"sol", "=", 
       RowBox[{"NDSolve", "[", 
        RowBox[{
         RowBox[{"{", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"Psi", "'"}], "[", "t", "]"}], "==", 
            RowBox[{
             RowBox[{
              RowBox[{"upath", "'"}], "[", "t", "]"}], "*", 
             RowBox[{
              RowBox[{"matA", "[", 
               RowBox[{"\[Lambda]", ",", 
                RowBox[{"upath", "[", "t", "]"}]}], "]"}], ".", 
              RowBox[{"Psi", "[", "t", "]"}]}]}]}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"Psi", "[", "0", "]"}], "==", 
            RowBox[{"IdentityMatrix", "[", "3", "]"}]}]}], 
          "\[IndentingNewLine]", "}"}], ",", " ", "Psi", ",", " ", 
         RowBox[{"{", 
          RowBox[{"t", ",", "0", ",", "1"}], "}"}], ",", 
         RowBox[{"WorkingPrecision", "->", "60"}], ",", 
         RowBox[{"MaxSteps", "->", 
          RowBox[{"10", "^", "6"}]}]}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"mon", "=", 
       RowBox[{
        RowBox[{"Psi", "[", "1", "]"}], "/.", 
        RowBox[{"First", "[", "sol", "]"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"LinearSolve", "[", 
