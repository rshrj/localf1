Cell[BoxData[
 RowBox[{"sol", "=", 
  RowBox[{"NDSolve", "[", 
   RowBox[{
    RowBox[{"{", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"Psi", "'"}], "[", "t", "]"}], "==", 
       RowBox[{
        RowBox[{
         RowBox[{"upath", "'"}], "[", "t", "]"}], "*", 
        RowBox[{
         RowBox[{"matA", "[", 
          RowBox[{"l0", ",", 
           RowBox[{"upath", "[", "t", "]"}]}], "]"}], ".", 
         RowBox[{"Psi", "[", "t", "]"}]}]}]}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"Psi", "[", "0", "]"}], "==", 
