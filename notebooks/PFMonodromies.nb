Cell[CellGroupData[{

Cell["Integrating to the cusp (to find the central charge there)", \
"Subsection",
 CellChangeTimes->{{3.977669438413569*^9, 
  3.9776694769911327`*^9}},ExpressionUUID->"01678e07-00f0-4cea-b619-\
5a182e78113a"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Options", "[", "ComputeTransition", "]"}], "=", 
   RowBox[{"{", 
    RowBox[{"WorkingPrecision", "->", "60"}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"ComputeTransition", "[", 
    RowBox[{"\[Lambda]_", ",", "upath_", ",", 
     RowBox[{"Nn_", ":", "512"}], ",", 
     RowBox[{"Nr_", ":", "5"}], ",", 
     RowBox[{"OptionsPattern", "[", "]"}]}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "sol", ",", "Psi", ",", "mon", ",", "SystMat", ",", "msg", ",", 
       RowBox[{"tt", "=", "0"}]}], "}"}], ",", 
     RowBox[{"Monitor", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"msg", "=", "\"\<Integrating the connection...\>\""}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"sol", "=", 
         RowBox[{"NDSolve", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"Psi", "'"}], "[", "t", "]"}], "==", 
              RowBox[{
               RowBox[{
                RowBox[{"upath", "'"}], "[", "t", "]"}], "*", 
               RowBox[{
                RowBox[{"PicardFuchsA", "[", 
                 RowBox[{"\[Lambda]", ",", 
                  RowBox[{"upath", "[", "t", "]"}]}], "]"}], ".", 
                RowBox[{"Psi", "[", "t", "]"}]}]}]}], ",", 
             RowBox[{
              RowBox[{"Psi", "[", "0", "]"}], "==", 
              RowBox[{"IdentityMatrix", "[", "3", "]"}]}]}], "}"}], ",", 
           "Psi", ",", 
           RowBox[{"{", 
            RowBox[{"t", ",", "0", ",", "1"}], "}"}], ",", 
           RowBox[{"WorkingPrecision", "->", 
            RowBox[{"OptionValue", "[", "WorkingPrecision", "]"}]}], ",", 
           RowBox[{"MaxSteps", "->", 
            RowBox[{"10", "^", "6"}]}], ",", 
           RowBox[{"StepMonitor", ":>", 
            RowBox[{"(", 
             RowBox[{"tt", "=", "t"}], ")"}]}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"mon", "=", 
         RowBox[{
          RowBox[{"Psi", "[", "1", "]"}], "/.", " ", 
          RowBox[{"First", "[", "sol", "]"}]}]}], ";", "\[IndentingNewLine]", 
        
        RowBox[{"msg", "=", "\"\<Solving for the system matrix...\>\""}], ";",
         "\[IndentingNewLine]", 
        RowBox[{"SystMat", "=", 
         RowBox[{"SystemMatrix", "[", 
          RowBox[{
           RowBox[{"F1Series", "[", 
            RowBox[{"\[Lambda]", ",", 
             RowBox[{"upath", "[", "0", "]"}], ",", "Nn", ",", "Nr"}], "]"}], 
           ",", "\[Lambda]", ",", 
           RowBox[{"upath", "[", "0", "]"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"LinearSolve", "[", 
         RowBox[{"SystMat", ",", 
          RowBox[{"mon", ".", "SystMat"}]}], "]"}]}], ",", 
       RowBox[{"msg", "<>", "\"\< \>\"", "<>", 
        RowBox[{"ToString", "[", 
         RowBox[{"Floor", "[", 
          RowBox[{"100", " ", "tt"}], "]"}], "]"}], "<>", "\"\<%.\>\""}]}], 
      "]"}]}], "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.9776694941665297`*^9, 
  3.977669494169153*^9}},ExpressionUUID->"b6534864-051d-4a60-81f6-\
010e46fe629c"],

