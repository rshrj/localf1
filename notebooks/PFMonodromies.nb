Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "ComputeTransition", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Options", "[", "ComputeTransition", "]"}], "=", 
   RowBox[{"{", 
    RowBox[{"WorkingPrecision", "->", "60"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"ComputeTransition", "[", 
    RowBox[{"\[Lambda]_", ",", "upath_", ",", " ", 
     RowBox[{"Nn_", ":", "512"}], ",", 
     RowBox[{"Nr_", ":", "5"}], ",", 
     RowBox[{"OptionsPattern", "[", "]"}]}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "sol", ",", "Psi", ",", "mon", ",", "SystMat", ",", " ", "msg", ",", 
       " ", 
       RowBox[{"tt", "=", "0"}]}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{"Monitor", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"msg", "=", "\"\<Integrating the connection...\>\""}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"sol", "=", 
         RowBox[{"NDSolve", "[", 
          RowBox[{
           RowBox[{"{", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"Psi", "'"}], "[", "t", "]"}], "==", 
              RowBox[{
               RowBox[{
                RowBox[{"upath", "'"}], "[", "t", "]"}], "*", 
               RowBox[{
                RowBox[{"matA", "[", 
                 RowBox[{"\[Lambda]", ",", 
                  RowBox[{"upath", "[", "t", "]"}]}], "]"}], ".", 
                RowBox[{"Psi", "[", "t", "]"}]}]}]}], ",", 
             "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"Psi", "[", "0", "]"}], "==", 
              RowBox[{"IdentityMatrix", "[", "3", "]"}]}]}], 
            "\[IndentingNewLine]", "}"}], ",", " ", "Psi", ",", " ", 
           RowBox[{"{", 
            RowBox[{"t", ",", "0", ",", "1"}], "}"}], ",", 
           RowBox[{"WorkingPrecision", "->", 
            RowBox[{"OptionValue", "[", "WorkingPrecision", "]"}]}], ",", 
           RowBox[{"MaxSteps", "->", 
            RowBox[{"10", "^", "6"}]}], ",", " ", 
           RowBox[{"StepMonitor", ":>", 
            RowBox[{"(", 
             RowBox[{"tt", "=", "t"}], ")"}]}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"mon", "=", 
         RowBox[{
          RowBox[{"Psi", "[", "1", "]"}], "/.", 
          RowBox[{"First", "[", "sol", "]"}]}]}], ";", "\[IndentingNewLine]", 
        
        RowBox[{"msg", "=", "\"\<Solving for the system matrix...\>\""}], ";",
         "\[IndentingNewLine]", 
        RowBox[{"SystMat", "=", 
         RowBox[{"SystemMatrix", "[", 
          RowBox[{
           RowBox[{"F1LV", "[", 
            RowBox[{"\[Lambda]", ",", 
             RowBox[{"upath", "[", "0", "]"}], ",", "Nn", ",", "Nr"}], "]"}], 
           ",", "\[Lambda]", ",", 
           RowBox[{"upath", "[", "0", "]"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"LinearSolve", "[", 
         RowBox[{"SystMat", ",", " ", 
          RowBox[{"mon", ".", "SystMat"}]}], "]"}]}], ",", " ", 
       RowBox[{"msg", "<>", "\"\< \>\"", "<>", 
        RowBox[{"ToString", "[", 
