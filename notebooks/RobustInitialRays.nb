         RowBox[{
          RowBox[{"Last", "[", "#", "]"}], "<=", "3"}], "&"}]}], "]"}]}]}], 
    "}"}], ",", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"constructDomain", "[", "asc_", "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", "ineq", "}"}], ",", 
       RowBox[{
        RowBox[{"ineq", "=", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"CollInequalities", "[", 
