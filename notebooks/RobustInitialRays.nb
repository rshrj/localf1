Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"IntersectRaysNoTest", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"r_", ",", "dF_", ",", "dB_", ",", "ch2_"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"rr_", ",", "ddF_", ",", "ddB_", ",", "cch2_"}], "}"}], ",", 
     "z_", ",", "zz_", ",", 
     RowBox[{"mu_", ":", "0"}]}], "]"}], ":=", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"returns", " ", 
      RowBox[{"(", 
       RowBox[{"x", ",", "y"}], ")"}], " ", "coordinate", " ", "of", " ", 
      "intersection", " ", "point", " ", "of", " ", "two", " ", "rays"}], ",", 
     RowBox[{"or", " ", 
      RowBox[{"{", "}"}], " ", "if", " ", "they", " ", 
      RowBox[{"don", "'"}], "t", " ", "intersect"}]}], "*)"}], 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"here", " ", "do", " ", "not", " ", "test", " ", "if", " ", 
      RowBox[{"DSZ", "<>", "0"}]}], ",", 
     RowBox[{
     "and", " ", "require", " ", "strictly", " ", "in", " ", "future", " ", 
      "of", " ", "z", " ", "and", " ", "zz"}]}], "*)"}], 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"zi", ",", "eta", ",", "eeta"}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"zi", "=", 
       RowBox[{"NaiveIntersection", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"r", ",", "dF", ",", "dB", ",", "ch2"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"rr", ",", "ddF", ",", "ddB", ",", "cch2"}], "}"}], ",", 
         "mu"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"eta", "=", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", "r"}], ",", 
         RowBox[{
          RowBox[{"2", "dF"}], "+", "dB"}]}], "}"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"eeta", "=", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", "rr"}], ",", 
         RowBox[{
          RowBox[{"2", "ddF"}], "+", "ddB"}]}], "}"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"eta", ".", 
           RowBox[{"(", 
            RowBox[{"zi", "-", "z"}], ")"}]}], ">", "0"}], "&&", 
         RowBox[{
          RowBox[{"eeta", ".", 
           RowBox[{"(", 
            RowBox[{"zi", "-", "zz"}], ")"}]}], ">", "0"}]}], ",", "zi", ",", 
        
        RowBox[{"{", "}"}]}], "]"}]}]}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.977378721098529*^9, 3.977378755847411*^9}, {
   3.977378804255394*^9, 3.97737891240994*^9}, {3.9773789477567663`*^9, 
   3.9773790915614433`*^9}, 3.977379333289302*^9},
 CellLabel->
  "In[174]:=",ExpressionUUID->"0b48018f-0052-448f-b707-e1681eb241b5"],

