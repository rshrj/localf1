Cell[BoxData[{
 RowBox[{
  RowBox[{"ToFB", "/@", "ObjectsToCheckHC"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"ObjectsToCheck", "=", 
  RowBox[{"Table", "[", 
   RowBox[{
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"FreeQ", "[", 
       RowBox[{"gam", ",", " ", "x"}], "]"}], ",", " ", "gam", ",", " ", 
      RowBox[{"gam", "/.", 
       RowBox[{"First", "[", 
        RowBox[{"Solve", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"BogomolovDiscriminant", "[", "gam", "]"}], "==", "0"}], ",",
