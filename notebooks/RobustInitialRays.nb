           RowBox[{"{", 
            RowBox[{"m", ",", "n"}], "}"}]}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"x", ",", "y"}], "}"}], ",", "mu"}], "]"}]}], "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"specs", "=", 
     RowBox[{"Flatten", "[", 
      RowBox[{
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"m", ",", "n"}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"m", ",", 
           RowBox[{"-", "10"}], ",", "10"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"n", ",", 
           RowBox[{"-", "10"}], ",", "10"}], "}"}]}], "]"}], ",", "1"}], 
      "]"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"Select", "[", 
      RowBox[{"specs", ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"Reduce", "[", 
          RowBox[{
           RowBox[{"a1", "[", "#", "]"}], ",", 
