           RowBox[{"-", "2"}], "+", "m"}], ")"}]}], "+", "n"}], ")"}], " ", 
      "x"}], "+", "y"}], "<", "0"}], ",", 
   RowBox[{
    RowBox[{
     RowBox[{"-", "n"}], "+", 
