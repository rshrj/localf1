Cell[BoxData[
 RowBox[{"CollInequalities", "[", 
  RowBox[{
   RowBox[{"SpectralFlow", "[", 
    RowBox[{
     RowBox[{"CollArcaraII", "/.", "repCh"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"m", ",", "n"}], "}"}]}], "]"}], ",", 
