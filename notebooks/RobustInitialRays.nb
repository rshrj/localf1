Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"mu", " ", 
      RowBox[{"(", 
       RowBox[{"m", "-", "n"}], ")"}]}], "-", 
     RowBox[{"m", " ", "n"}], "+", 
     FractionBox[
      SuperscriptBox["n", "2"], "2"], "+", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"2", " ", "m"}], "+", "n"}], ")"}], " ", "x"}], "+", "y"}], "<",
     "0"}], ",", 
   RowBox[{
    RowBox[{
     RowBox[{"-", 
      FractionBox["1", "2"]}], "+", "m", "+", "mu", "-", "n", "-", "x"}], "<",
     "0"}], ",", 
   RowBox[{
    RowBox[{
     RowBox[{"-", 
      FractionBox["3", "2"]}], "+", "m", "+", 
     RowBox[{"mu", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", "1"}], "+", "m", "-", "n"}], ")"}]}], "+", "n", "-", 
     RowBox[{"m", " ", "n"}], "+", 
     FractionBox[
      SuperscriptBox["n", "2"], "2"], "+", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", "1"}], "+", 
        RowBox[{"2", " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"-", "2"}], "+", "m"}], ")"}]}], "+", "n"}], ")"}], " ", 
      "x"}], "+", "y"}], "<", "0"}], ",", 
   RowBox[{
    RowBox[{
     FractionBox["1", "2"], "-", "m", "+", 
     RowBox[{"m", " ", "n"}], "-", 
     FractionBox[
      SuperscriptBox["n", "2"], "2"], "+", 
     RowBox[{"mu", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", "m"}], "+", "n"}], ")"}]}], "+", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"1", "+", 
        RowBox[{"2", " ", 
         RowBox[{"(", 
          RowBox[{"1", "-", "m"}], ")"}]}], "-", "n"}], ")"}], " ", "x"}], "-",
      "y"}], "<", "0"}]}], "}"}]], "Output",
 CellChangeTimes->{3.976955946427622*^9},
 CellLabel->
  "Out[351]=",ExpressionUUID->"9155af0a-35ef-4253-a07d-4128c5ae4f98"]
