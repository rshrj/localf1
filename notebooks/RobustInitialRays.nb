     FractionBox[
      SuperscriptBox["n", "2"], "2"], "+", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"2", " ", "m"}], "+", "n"}], ")"}], " ", "x"}], "+", "y"}], "<",
     "0"}], ",", 
