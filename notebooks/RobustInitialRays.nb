Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "CollInequalities", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"CollInequalities", "[", 
    RowBox[{"Coll_", ",", 
     RowBox[{"{", 
      RowBox[{"x_", ",", "y_"}], "}"}], ",", " ", "mu_"}], "]"}], ":=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"gam", "[", 
         RowBox[{"[", "1", "]"}], "]"}], "y"}], "+", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"gam", "[", 
           RowBox[{"[", "3", "]"}], "]"}], "+", 
          RowBox[{"2", 
           RowBox[{"gam", "[", 
            RowBox[{"[", "2", "]"}], "]"}]}]}], ")"}], "x"}], "+", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"gam", "[", 
           RowBox[{"[", "2", "]"}], "]"}], "-", 
          RowBox[{"gam", "[", 
           RowBox[{"[", "3", "]"}], "]"}]}], ")"}], "mu"}], "-", 
       RowBox[{"gam", "[", 
        RowBox[{"[", "4", "]"}], "]"}]}], "<", "0"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"gam", ",", "Coll"}], "}"}]}], "]"}]}], ";"}]}], "Input",
