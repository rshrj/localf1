Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "a1", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"mu", "=", 
     RowBox[{
      RowBox[{"-", "1"}], "/", "10"}]}], "}"}], ",", 
   RowBox[{
    RowBox[{
     RowBox[{"a1", "[", 
      RowBox[{"{", 
       RowBox[{"m_", ",", "n_"}], "}"}], "]"}], "=", 
     RowBox[{"Simplify", "[", 
      RowBox[{"And", "@@", 
       RowBox[{"CollInequalities", "[", 
        RowBox[{
         RowBox[{"SpectralFlow", "[", 
          RowBox[{
           RowBox[{"CollArcaraII", "/.", "repCh"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"m", ",", "n"}], "}"}]}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"x", ",", "y"}], "}"}], ",", "mu"}], "]"}]}], "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"specs", "=", 
     RowBox[{"Flatten", "[", 
      RowBox[{
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"m", ",", "n"}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"m", ",", 
           RowBox[{"-", "10"}], ",", "10"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"n", ",", 
           RowBox[{"-", "10"}], ",", "10"}], "}"}]}], "]"}], ",", "1"}], 
      "]"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"Select", "[", 
      RowBox[{"specs", ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"Reduce", "[", 
          RowBox[{
           RowBox[{"a1", "[", "#", "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"x", ",", "y"}], "}"}]}], "]"}], "=!=", "False"}], 
        "&"}]}], "]"}], "===", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"m", ",", 
         RowBox[{"Ceiling", "[", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"2", "m"}], "+", 
             RowBox[{"3", "mu"}], "-", "1"}], ")"}], "/", "3"}], "]"}]}], 
        "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"m", ",", 
         RowBox[{"-", "10"}], ",", "10"}], "}"}]}], "]"}]}]}]}], 
  "]"}]}], "Input",
