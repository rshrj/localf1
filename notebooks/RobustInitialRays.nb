Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"mu", " ", 
      RowBox[{"(", 
       RowBox[{"m", "-", "n"}], ")"}]}], "-", 
     RowBox[{"m", " ", "n"}], "+", 
     FractionBox[
      SuperscriptBox["n", "2"], "2"], "+", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"2", " ", "m"}], "+", "n"}], ")"}], " ", "x"}], "+", "y"}], "<",
     "0"}], ",", 
   RowBox[{
    RowBox[{
     FractionBox["1", "2"], "-", "m", "-", "mu", "+", "n", "+", "x"}], "<", 
