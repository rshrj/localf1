Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"mu", "=", 
      RowBox[{
       RowBox[{"-", "1"}], "/", "6"}]}], ",", " ", 
     RowBox[{"L", "=", "4"}], ",", " ", 
     RowBox[{"Lp", "=", "3"}], ",", 
     RowBox[{"len", "=", "20"}]}], "}"}], ",", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"constructDomain", "[", "asc_", "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", "ineq", "}"}], ",", 
       RowBox[{
        RowBox[{"ineq", "=", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"CollInequalities", "[", 
            RowBox[{
             RowBox[{"SpectralFlow", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"asc", "[", "\"\<coll\>\"", "]"}], "/.", "repCh"}], ",",
                " ", 
               RowBox[{"{", 
                RowBox[{"mF", ",", 
                 RowBox[{"Ceiling", "[", 
                  RowBox[{
                   RowBox[{"asc", "[", "\"\<mB\>\"", "]"}], "[", 
                   RowBox[{"mF", ",", "mu"}], "]"}], "]"}]}], "}"}]}], "]"}], 
             ",", 
             RowBox[{"{", 
              RowBox[{"x", ",", "y"}], "}"}], ",", "mu"}], "]"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"mF", ",", " ", 
             RowBox[{"-", "L"}], ",", "L"}], "}"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"EdgeForm", "[", 
           RowBox[{"Opacity", "[", 
            RowBox[{".25", ",", 
             RowBox[{"asc", "[", "\"\<color\>\"", "]"}]}], "]"}], "]"}], ",", 
          " ", 
          RowBox[{
           RowBox[{
            RowBox[{"DiscretizeRegion", "[", 
             RowBox[{"ImplicitRegion", "[", 
              RowBox[{
               RowBox[{"And", "@@", "#"}], ",", 
               RowBox[{"{", 
                RowBox[{"x", ",", "y"}], "}"}]}], "]"}], "]"}], "&"}], "/@", 
           "ineq"}]}], "}"}]}]}], "\[IndentingNewLine]", "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"rays", "=", 
     RowBox[{"Flatten", "[", 
      RowBox[{
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"{", 
            RowBox[{"#", ",", " ", 
             RowBox[{"InitialPositionXY", "[", 
              RowBox[{"#", ",", " ", "mu"}], "]"}], ",", "0", ",", "0", ",", 
             "0", ",", "0", ",", "0"}], "}"}], "&"}], "[", 
          RowBox[{
           RowBox[{"s", " ", 
            RowBox[{"Ch", "[", 
             RowBox[{"p", ",", "q"}], "]"}]}], "/.", "repCh"}], "]"}], ",", 
         " ", 
         RowBox[{"{", 
          RowBox[{"p", ",", 
           RowBox[{"-", "Lp"}], ",", "Lp"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"q", ",", 
           RowBox[{"-", "Lp"}], ",", "Lp"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"s", ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"-", "1"}], ",", "1"}], "}"}]}], "}"}]}], "]"}], ",", 
       " ", "2"}], "]"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"rays", "=", 
     RowBox[{"InitialRaysFromColl", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"colls", "[", 
         RowBox[{"[", "3", "]"}], "]"}], "/.", "repCh"}], ",", " ", 
       RowBox[{"-", "1"}], ",", "1", ",", "mu"}], "]"}]}], ";", 
    "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{"Show", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Plot", "[", 
       RowBox[{
        RowBox[{"XYParabolaY", "[", 
         RowBox[{"x", ",", "mu", ",", "0", ",", "0"}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"x", ",", 
          RowBox[{"-", "2"}], ",", "2"}], "}"}], ",", "\[IndentingNewLine]", 
        RowBox[{"PlotRange", "->", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"-", "1"}], ",", "1"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"-", "5"}], ",", "2"}], "}"}]}], "}"}]}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"PlotStyle", "->", 
         RowBox[{"Directive", "[", 
          RowBox[{"Dashed", ",", "Thick", ",", "Black"}], "]"}]}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"GridLines", "->", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"-", "0.2"}], ",", "1.2"}], "}"}], ",", "None"}], 
          "}"}]}]}], "\[IndentingNewLine]", "]"}], ",", "\[IndentingNewLine]", 
      RowBox[{"Graphics", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Opacity", "[", ".25", "]"}], ",", 
         RowBox[{"constructDomain", "/@", "plotData"}]}], "}"}], "]"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"Graphics", "[", 
       RowBox[{"{", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"Tooltip", "[", 
            RowBox[{
             RowBox[{"raySeg", "[", 
              RowBox[{"#", ",", "mu", ",", "len", ",", 
               RowBox[{"<|", "|>"}], ",", 
               RowBox[{"Directive", "[", 
                RowBox[{
                 RowBox[{"Thickness", "[", ".001", "]"}], ",", "Black"}], 
                "]"}]}], "]"}], ",", " ", 
             RowBox[{"#", "[", 
              RowBox[{"[", "1", "]"}], "]"}]}], "]"}], "&"}], "/@", "rays"}], 
         ",", "    ", 
         RowBox[{"(*", "rays", "*)"}], "\[IndentingNewLine]", 
         RowBox[{"PointSize", "[", ".004", "]"}], ",", "Red", ",", 
         "\[IndentingNewLine]", 
         RowBox[{"Point", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"#", "[", 
             RowBox[{"[", "2", "]"}], "]"}], "&"}], "/@", "rays"}], "]"}]}], 
        "                   ", 
        RowBox[{"(*", 
         RowBox[{"initial", " ", "positions"}], "*)"}], "\[IndentingNewLine]",
         "}"}], "]"}]}], "\[IndentingNewLine]", "]"}]}]}], 
  "\[IndentingNewLine]", "]"}]], "Input",
