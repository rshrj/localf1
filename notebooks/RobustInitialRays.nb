Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "a1", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"mu", "=", 
     RowBox[{
      RowBox[{"-", "1"}], "/", "10"}]}], "}"}], ",", 
   RowBox[{
    RowBox[{
     RowBox[{"a1", "[", 
      RowBox[{"{", 
       RowBox[{"m_", ",", "n_"}], "}"}], "]"}], "=", 
     RowBox[{"Simplify", "[", 
      RowBox[{"And", "@@", 
       RowBox[{"CollInequalities", "[", 
        RowBox[{
         RowBox[{"SpectralFlow", "[", 
          RowBox[{
