     RowBox[{"mu", "=", 
      RowBox[{
       RowBox[{"-", "1"}], "/", "10"}]}], ",", " ", 
     RowBox[{"L", "=", "4"}], ",", " ", 
     RowBox[{"Lp", "=", "3"}], ",", 
     RowBox[{"len", "=", "20"}], ",", 
     RowBox[{"rays", "=", 
      RowBox[{"Select", "[", 
