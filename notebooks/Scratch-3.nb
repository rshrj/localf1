Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "companionMatrix", "]"}], ";"}], 
  "\[IndentingNewLine]", "\n", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Input", ":", 
     RowBox[{
      RowBox[{"ode", " ", "is", " ", "an", " ", "equation"}], "==", 
      RowBox[{"0", " ", "or", " ", "an", " ", "expression"}]}]}], ";", 
    RowBox[{"y", " ", "is", " ", "the", " ", "function", " ", "symbol"}], ";", 
    RowBox[{"x", " ", "is", " ", "variable"}]}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"companionMatrix", "[", 
    RowBox[{"ode_", ",", "y_Symbol", ",", "x_Symbol"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "expr", ",", "n", ",", "uk", ",", "coeffs", ",", "an", ",", "rhs", ",", 
       "bottomRow", ",", "A"}], "}"}], ",", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{
       "normalize", " ", "to", " ", "an", " ", "expression", 
        " ", "\"\<==0\>\""}], "->", 
       RowBox[{"lhs", "-", "rhs"}]}], "*)"}], 
     RowBox[{
      RowBox[{"expr", "=", 
       RowBox[{
        RowBox[{"ode", "/.", " ", 
         RowBox[{"Equal", "->", "Subtract"}]}], "//", "Expand"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"detect", " ", "order"}], "*)"}], 
      RowBox[{"n", "=", 
       RowBox[{"Max", "@", 
        RowBox[{"Cases", "[", 
         RowBox[{"expr", ",", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"Derivative", "[", "k_", "]"}], "[", "y", "]"}], "[", 
            "x", "]"}], ":>", "k"}], ",", "Infinity"}], "]"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"!", 
          RowBox[{"IntegerQ", "[", "n", "]"}]}], "||", 
         RowBox[{"n", "<", "1"}]}], ",", 
        RowBox[{"Return", "[", 
         RowBox[{"$Failed", ",", "Module"}], "]"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"replace", " ", 
        RowBox[{"y", "^", 
         RowBox[{"(", "k", ")"}]}], 
        RowBox[{"(", "x", ")"}], " ", "by", " ", 
        RowBox[{"u", "[", "k", "]"}], " ", "to", " ", "extract", " ", 
        "linear", " ", "coefficients"}], "*)"}], 
      RowBox[{"uk", "=", 
       RowBox[{"Array", "[", 
        RowBox[{"u", ",", 
         RowBox[{"n", "+", "1"}], ",", "0"}], "]"}]}], ";", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{
         RowBox[{"u", "[", "0", "]"}], ".."}], 
        RowBox[{"u", "[", "n", "]"}]}], "*)"}], 
      RowBox[{"coeffs", "=", 
       RowBox[{"Coefficient", "[", 
        RowBox[{
         RowBox[{"expr", "/.", " ", 
          RowBox[{"Join", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"y", "[", "x", "]"}], "->", 
              RowBox[{"u", "[", "0", "]"}]}], "}"}], ",", 
            RowBox[{"Table", "[", 
             RowBox[{
              RowBox[{
               RowBox[{
                RowBox[{
                 RowBox[{"Derivative", "[", "k", "]"}], "[", "y", "]"}], "[", 
                "x", "]"}], "->", 
               RowBox[{"u", "[", "k", "]"}]}], ",", 
              RowBox[{"{", 
               RowBox[{"k", ",", "1", ",", "n"}], "}"}]}], "]"}]}], "]"}]}], ",",
          "uk"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"an", "=", 
       RowBox[{"coeffs", "[", 
        RowBox[{"[", 
         RowBox[{"n", "+", "1"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"an", "===", "0"}], ",", 
        RowBox[{"Return", "[", 
         RowBox[{"$Failed", ",", "Module"}], "]"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"y", "^", 
         RowBox[{"(", "n", ")"}]}], "=", 
        RowBox[{
         RowBox[{"-", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"a0", " ", "y"}], "+", 
              RowBox[{"a1", " ", 
               RowBox[{"y", "'"}]}], "+"}], "..."}], "+", 
            RowBox[{"a_", 
             RowBox[{"{", 
              RowBox[{"n", "-", "1"}], "}"}], " ", 
             RowBox[{"y", "^", 
              RowBox[{"(", 
               RowBox[{"n", "-", "1"}], ")"}]}]}]}], ")"}]}], "/", "an"}]}], 
       "*)"}], 
      RowBox[{"rhs", "=", 
       RowBox[{
        RowBox[{"-", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"Most", "[", "coeffs", "]"}], ".", 
           RowBox[{"Most", "[", "uk", "]"}]}], ")"}]}], "/", "an"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"bottomRow", "=", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"Coefficient", "[", 
          RowBox[{"rhs", ",", 
           RowBox[{"u", "[", "j", "]"}]}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"j", ",", "0", ",", 
           RowBox[{"n", "-", "1"}]}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"build", " ", "companion", " ", "A", 
