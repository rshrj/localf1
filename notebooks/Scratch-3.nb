Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Compute", " ", "the", " ", "repo", " ", "root", " ", "from", " ", "the", " ",
     "notebook", " ", "location"}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"repoRoot", "=", 
     RowBox[{"ParentDirectory", "@", 
      RowBox[{"NotebookDirectory", "[", "]"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"repoAppDir", "=", 
     RowBox[{"FileNameJoin", "[", 
      RowBox[{"{", 
       RowBox[{"repoRoot", ",", "\"\<mma\>\""}], "}"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"!", 
       RowBox[{"MemberQ", "[", 
        RowBox[{"$Path", ",", "repoAppDir"}], "]"}]}], ",", 
      RowBox[{
       RowBox[{"AppendTo", "[", 
        RowBox[{"$Path", ",", "repoAppDir"}], "]"}], ";"}]}], "]"}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"ClearAll", "[", "\"\<LocalF1`*\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"<<", "LocalF1`"}], ";"}]}]}]], "Input",
