       RowBox[{"zp", "[", "t", "]"}], "/", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"z", "[", "t", "]"}], "^", "2"}], "+", "1"}], ")"}]}]}], ",",
      " ", 
     RowBox[{
      RowBox[{"Phi", "[", "0", "]"}], "==", "0."}]}], "}"}], ",", " ", "Phi", 
   ",", " ", 
