  RowBox[{
   RowBox[{"WallCircle", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"r_", ",", "dF_", ",", "dB_", ",", "ch2_"}], "}"}], ",", 
     RowBox[{"{", 
