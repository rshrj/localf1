Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"varpi2", " ", "with", " ", "Richardson"}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"varpi2", "[", 
     RowBox[{"u_", ",", "lam_"}], "]"}], ":=", 
    RowBox[{"With", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Nn", "=", "1024"}], ",", " ", 
        RowBox[{"d", "=", "15"}]}], "}"}], ",", " ", 
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"terms", ",", "sums"}], "}"}], ",", " ", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"terms", "=", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"Sum", "[", 
              RowBox[{
               RowBox[{"If", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{"Mod", "[", 
                   RowBox[{
                    RowBox[{"n", "-", 
                    RowBox[{"2", "l"}]}], ",", " ", "3"}], "]"}], "==", "0"}],
                  ",", " ", 
                 RowBox[{
                  RowBox[{
                   RowBox[{
                    RowBox[{
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{"n", "-", "1"}], ")"}], "!"}], "/", 
                    RowBox[{
                    RowBox[{"Factorial", "[", 
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{"n", "-", 
                    RowBox[{"2", "l"}]}], ")"}], "/", "3"}], "]"}], "^", 
                    "2"}]}], "/", 
                    RowBox[{"Factorial", "[", "l", "]"}]}], "/", 
                   RowBox[{"Factorial", "[", 
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{"n", "+", "l"}], ")"}], "/", "3"}], "]"}]}], " ", 
                  
                  RowBox[{"lam", "^", "l"}]}], ",", " ", "0"}], "]"}], ",", 
               " ", 
               RowBox[{"{", 
                RowBox[{"l", ",", "0", ",", "n"}], "}"}]}], "]"}], 
             RowBox[{"u", "^", "n"}]}], ",", " ", 
            RowBox[{"{", 
             RowBox[{"n", ",", " ", "2", ",", " ", "Nn"}], "}"}]}], "]"}]}], ";",
          "\[IndentingNewLine]", 
         RowBox[{"sums", "=", 
          RowBox[{
           RowBox[{"-", 
            RowBox[{"Log", "[", "u", "]"}]}], "-", 
           RowBox[{"Accumulate", "[", "terms", "]"}]}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"Sum", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"sums", "[", 
               RowBox[{"[", 
                RowBox[{"n", "+", "k"}], "]"}], "]"}], 
              RowBox[{
               RowBox[{"(", 
                RowBox[{"n", "+", "k"}], ")"}], "^", "d"}], 
              RowBox[{
               RowBox[{
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{"-", "1"}], ")"}], "^", 
                 RowBox[{"(", 
                  RowBox[{"k", "+", "d"}], ")"}]}], "/", 
                RowBox[{"k", "!"}]}], "/", 
               RowBox[{
                RowBox[{"(", 
                 RowBox[{"d", "-", "k"}], ")"}], "!"}]}]}], ",", " ", 
             RowBox[{"{", 
              RowBox[{"k", ",", " ", "0", ",", " ", "d"}], "}"}]}], "]"}], ",",
            " ", 
           RowBox[{"{", 
            RowBox[{"n", ",", " ", "1", ",", " ", 
             RowBox[{
              RowBox[{"Length", "[", "sums", "]"}], "-", "d"}]}], "}"}]}], 
          "]"}]}]}], "\[IndentingNewLine]", "]"}]}], "]"}]}], 
   ";"}]}]], "Input",
