Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "Rayxy", "]"}], ";"}], "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "redefine", " ", "Rayxy", " ", "such", " ", "that", " ", "second", " ", 
     "argument", " ", "is", " ", "z"}], "=", 
    RowBox[{"{", 
     RowBox[{"x", ",", "y"}], "}"}]}], " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Rayxy", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"r_", ",", "dF_", ",", "dB_", ",", "ch2_"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"x0_", ",", "y0_"}], "}"}], ",", "L_", ",", "m_"}], "]"}], ":=",
    "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Hue", "[", 
      RowBox[{"1", "-", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"CostPhi", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"r", ",", "dF", ",", "dB", ",", "ch2"}], "}"}], ",", "x0",
            ",", "m"}], "]"}], ")"}], "/", "4.6"}]}], "]"}], ",", 
     RowBox[{"Point", "[", 
      RowBox[{"{", 
