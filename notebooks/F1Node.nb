        RowBox[{"{", 
         RowBox[{
          RowBox[{"x0", "-", 
           RowBox[{"r", " ", "L"}]}], ",", 
          RowBox[{"y0", "+", 
           RowBox[{"L", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"2", "dF"}], "+", "dB"}], ")"}]}]}]}], "}"}]}], "}"}], 
      "]"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"m", "=", 
