Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"varpi3", " ", "with", " ", "Richardson"}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"varpi3", "[", 
     RowBox[{"z_", ",", "lam_"}], "]"}], ":=", 
    RowBox[{"With", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Nn", "=", "200"}], ",", " ", 
        RowBox[{"d", "=", "5"}]}], "}"}], ",", " ", 
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"terms", ",", "sums"}], "}"}], ",", " ", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"terms", "=", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"Sum", "[", 
              RowBox[{
               RowBox[{
                RowBox[{
                 RowBox[{
                  RowBox[{
                   RowBox[{
                    RowBox[{"(", 
                    RowBox[{"2", "n"}], ")"}], "!"}], "/", "n"}], "/", 
                  RowBox[{
                   RowBox[{"Factorial", "[", 
                    RowBox[{"n", "-", "l"}], "]"}], "^", "2"}]}], "/", 
                 RowBox[{
                  RowBox[{"Factorial", "[", "l", "]"}], "^", "2"}]}], 
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"HarmonicNumber", "[", 
                   RowBox[{"n", "-", "l"}], "]"}], "+", 
                  RowBox[{"HarmonicNumber", "[", "l", "]"}], "-", 
                  RowBox[{"2", 
                   RowBox[{"HarmonicNumber", "[", 
                    RowBox[{"2", "n"}], "]"}]}], "+", 
                  RowBox[{"1", "/", "n"}]}], ")"}], " ", 
                RowBox[{"lam", "^", "l"}]}], ",", " ", 
               RowBox[{"{", 
                RowBox[{"l", ",", "0", ",", "n"}], "}"}]}], "]"}], 
             RowBox[{"z", "^", "n"}]}], ",", " ", 
            RowBox[{"{", 
             RowBox[{"n", ",", " ", "1", ",", " ", "Nn"}], "}"}]}], "]"}]}], ";",
          "\[IndentingNewLine]", 
         RowBox[{"sums", "=", 
          RowBox[{
           RowBox[{"-", 
            RowBox[{
             RowBox[{"Log", "[", "z", "]"}], "^", "2"}]}], "+", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{"2", 
               RowBox[{"Log", "[", "z", "]"}]}], "+", 
              RowBox[{"Log", "[", "lam", "]"}]}], ")"}], 
            RowBox[{"Last", "[", 
             RowBox[{"varpi2", "[", 
              RowBox[{"z", ",", "lam"}], "]"}], "]"}]}], "-", 
           RowBox[{"2", 
            RowBox[{"Accumulate", "[", "terms", "]"}]}]}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"Sum", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"sums", "[", 
               RowBox[{"[", 
                RowBox[{"n", "+", "k"}], "]"}], "]"}], 
              RowBox[{
               RowBox[{"(", 
                RowBox[{"n", "+", "k"}], ")"}], "^", "d"}], 
              RowBox[{
               RowBox[{
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{"-", "1"}], ")"}], "^", 
                 RowBox[{"(", 
                  RowBox[{"k", "+", "d"}], ")"}]}], "/", 
                RowBox[{"k", "!"}]}], "/", 
               RowBox[{
                RowBox[{"(", 
                 RowBox[{"d", "-", "k"}], ")"}], "!"}]}]}], ",", " ", 
             RowBox[{"{", 
              RowBox[{"k", ",", " ", "0", ",", " ", "d"}], "}"}]}], "]"}], ",",
            " ", 
           RowBox[{"{", 
            RowBox[{"n", ",", " ", "1", ",", " ", 
             RowBox[{
              RowBox[{"Length", "[", "sums", "]"}], "-", "d"}]}], "}"}]}], 
          "]"}]}]}], "\[IndentingNewLine]", "]"}]}], "]"}]}], 
   ";"}]}]], "Input",
