                  RowBox[{"HarmonicNumber", "[", "l", "]"}], "-", 
                  RowBox[{"2", 
                   RowBox[{"HarmonicNumber", "[", 
                    RowBox[{"2", "n"}], "]"}]}], "+", 
                  RowBox[{"1", "/", "n"}]}], ")"}], " ", 
                RowBox[{"lam", "^", "l"}]}], ",", " ", 
               RowBox[{"{", 
                RowBox[{"l", ",", "0", ",", "n"}], "}"}]}], "]"}], 
             RowBox[{"z", "^", "n"}]}], ",", " ", 
            RowBox[{"{", 
