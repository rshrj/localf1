Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "RatData", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"RatData", "[", 
     RowBox[{"expr_", ",", "var_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "t", ",", "num", ",", "den", ",", "fn", ",", "fd", ",", "all", ",", 
        "linear"}], "}"}], ",", 
      RowBox[{"(*", 
       RowBox[{"make", " ", "sure", " ", 
        RowBox[{"it", "'"}], "s", " ", "really", " ", "a", " ", "single", " ",
         "rational", " ", "expression"}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"t", "=", 
        RowBox[{"Together", "[", "expr", "]"}]}], ";", "\[IndentingNewLine]", 
       
       RowBox[{"num", "=", 
        RowBox[{"Numerator", "[", "t", "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"den", "=", 
        RowBox[{"Denominator", "[", "t", "]"}]}], ";", "\[IndentingNewLine]", 
       
       RowBox[{"(*", 
        RowBox[{
        "factor", " ", "numerator", " ", "and", " ", "denominator", " ", "in",
