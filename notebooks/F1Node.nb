            RowBox[{
             RowBox[{"Sum", "[", 
              RowBox[{
               RowBox[{
                RowBox[{
                 RowBox[{
                  RowBox[{
                   RowBox[{
                    RowBox[{"(", 
                    RowBox[{"2", "n"}], ")"}], "!"}], "/", "n"}], "/", 
                  RowBox[{
                   RowBox[{"Factorial", "[", 
                    RowBox[{"n", "-", "l"}], "]"}], "^", "2"}]}], "/", 
                 RowBox[{
                  RowBox[{"Factorial", "[", "l", "]"}], "^", "2"}]}], 
