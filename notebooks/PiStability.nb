            RowBox[{
             RowBox[{
              RowBox[{"Transpose", "[", "mat", "]"}], ".", "mat"}], ",", 
             RowBox[{
              RowBox[{"Transpose", "[", "mat", "]"}], ".", "vec"}]}], "]"}]}],
           ";", "\[IndentingNewLine]", 
          RowBox[{"Thread", "[", 
           RowBox[{"vars", "->", "solvec"}], "]"}]}]}], "]"}]}]}], "]"}]}], 
   ";"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
