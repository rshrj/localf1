Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"args", "=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"1", "-", 
       RowBox[{"1", "/", 
        RowBox[{"b", "^", "3"}]}]}], ",", 
      RowBox[{"1", "/", 
       RowBox[{"b", "^", "2"}]}], ",", 
      RowBox[{"1", "-", 
       RowBox[{"1", "/", 
        RowBox[{"b", "^", "2"}]}]}], ",", 
      RowBox[{"1", "/", "b"}], ",", 
      RowBox[{"1", "-", "b"}], ",", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", "1"}], "+", "b"}], ")"}], "/", "b"}], ",", "b", ",", 
      RowBox[{"1", "-", 
       RowBox[{"b", "^", "2"}]}], ",", 
      RowBox[{"-", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"b", " ", 
           RowBox[{"(", 
            RowBox[{"1", "+", "b", "+", 
             RowBox[{"b", "^", "2"}]}], ")"}]}], ")"}], "/", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"1", "+", "b"}], ")"}], "^", "4"}]}], ")"}]}], ",", 
      RowBox[{"-", 
       RowBox[{"(", 
