    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", "ser", "}"}], ",", 
      RowBox[{
       RowBox[{"ser", "=", 
        RowBox[{"Series", "[", 
         RowBox[{"expr", ",", 
          RowBox[{"{", 
           RowBox[{"u", ",", "0", ",", "n"}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
