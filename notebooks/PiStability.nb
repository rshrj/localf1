  RowBox[{"b0", "=", 
   RowBox[{"res", "[", "\"\<finalRoots\>\"", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"n", "=", 
   RowBox[{"Length", "[", "a0", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"idx", "=", 
   RowBox[{"First", "/@", 
    RowBox[{"Nearest", "[", 
     RowBox[{
      RowBox[{"b0", "->", 
       RowBox[{"Range", "[", "n", "]"}]}], ",", "a0", ",", 
      RowBox[{"DistanceFunction", "->", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"Abs", "[", 
          RowBox[{"#1", "-", "#2"}], "]"}], "&"}], ")"}]}]}], "]"}]}]}], 
  ";"}], "\n", 
 RowBox[{"If", "[", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"Sort", "[", "idx", "]"}], "===", 
     RowBox[{"Range", "[", "n", "]"}]}], "&&", 
    RowBox[{
     RowBox[{"Max", "[", 
      RowBox[{"Abs", "[", 
       RowBox[{"a0", "-", 
        RowBox[{"b0", "[", 
         RowBox[{"[", "idx", "]"}], "]"}]}], "]"}], "]"}], "<", "tol"}]}], ",", 
   RowBox[{"PermutationCycles", "[", "idx", "]"}], ",", 
   RowBox[{"Missing", "[", "\"\<NotAPermutationWithinTolerance\>\"", "]"}]}], 
  "]"}]}], "Input",
 CellChangeTimes->{{3.9790217316979427`*^9, 3.979021731702044*^9}, 
