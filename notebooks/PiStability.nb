Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"PolyEl", "[", 
    RowBox[{"b_", ",", "el_"}], "]"}], "=", 
   RowBox[{
    RowBox[{"Numerator", "[", 
     RowBox[{"KerrDoranElFromb", "[", "b", "]"}], "]"}], "-", 
    RowBox[{"el", " ", 
     RowBox[{"Denominator", "[", 
      RowBox[{"KerrDoranElFromb", "[", "b", "]"}], "]"}]}]}]}], 
  ";"}]], "Input",
