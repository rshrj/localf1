      RowBox[{"Axes", "->", "False"}], ",", 
      RowBox[{"PlotRange", "->", "All"}]}], "]"}], ",", 
    RowBox[{"Placed", "[", 
     RowBox[{
      RowBox[{"LineLegend", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"ColorData", "[", "97", "]"}], "/@", 
         RowBox[{"Range", "[", 
          RowBox[{"Length", "@", "args"}], "]"}]}], ",", "labels"}], "]"}], ",",
       "Right"}], "]"}]}], "]"}]}], "\n"}], "Input",
