Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"HeavisideTheta", "[", 
    RowBox[{
     RowBox[{"-", "x"}], "-", 
     RowBox[{"1", "/", "2"}]}], "]"}], " ", 
   RowBox[{"(", 
    RowBox[{"1", "-", 
     RowBox[{
      RowBox[{"HeavisideTheta", "[", 
       RowBox[{
        RowBox[{"-", "y"}], "-", 
        RowBox[{
         RowBox[{"Sqrt", "[", "3", "]"}], " ", "x"}]}], "]"}], " ", 
      RowBox[{"HeavisideTheta", "[", 
       RowBox[{"y", "-", 
        RowBox[{
         RowBox[{"Sqrt", "[", "3", "]"}], " ", "x"}]}], "]"}]}]}], ")"}]}], "/.", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"x", "->", 
     RowBox[{"Re", "[", "b", "]"}]}], ",", 
    RowBox[{"y", "->", 
     RowBox[{"Im", "[", "b", "]"}]}]}], "}"}]}]], "Input",
 CellChangeTimes->{{3.979054668794279*^9, 3.979054695182863*^9}},
