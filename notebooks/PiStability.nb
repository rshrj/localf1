         RowBox[{"(", 
          RowBox[{"1", "+", "b", "+", 
           RowBox[{"b", "^", "2"}]}], ")"}], "/", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"1", "+", "b"}], ")"}], "^", "2"}]}], ")"}]}], ",", " ", 
      RowBox[{"1", "+", "b", "+", 
       SuperscriptBox["b", "2"]}]}], "}"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"labels", "=", 
    RowBox[{"{", 
     RowBox[{"\"\<1-1/b^3\>\"", ",", "\"\<1/b^2\>\"", ",", "\"\<1-1/b^2\>\"", 
      ",", "\"\<1/b\>\"", ",", "\"\<1-b\>\"", ",", "\"\<(-1+b)/b\>\"", 
      ",", "\"\<b\>\"", ",", "\"\<1-b^2\>\"", 
      ",", "\"\<-b(1+b+b^2)/(1+b)^4\>\"", ",", "\"\<-(1+b+b^2)/(1+b)^2\>\""}],
      "}"}]}], ";"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"R", "=", "4"}], ";", 
   RowBox[{"pp", "=", "120"}], ";", 
   RowBox[{"mr", "=", "2"}], ";", 
   RowBox[{"eps", "=", 
    RowBox[{"10", "^", 
     RowBox[{"-", "8"}]}]}], ";"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"safe", "[", "f_", "]"}], ":=", 
    RowBox[{"Function", "[", 
     RowBox[{
      RowBox[{"{", "z", "}"}], ",", 
      RowBox[{"Quiet", "@", 
       RowBox[{"Check", "[", 
        RowBox[{
         RowBox[{"f", "/.", " ", 
          RowBox[{"b", "->", "z"}]}], ",", "Indeterminate"}], "]"}]}]}], 
     "]"}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"plots", "=", 
    RowBox[{"MapIndexed", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"With", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"g", "=", 
            RowBox[{"safe", "[", "#1", "]"}]}], ",", 
           RowBox[{"col", "=", 
            RowBox[{
             RowBox[{"ColorData", "[", "97", "]"}], "[", 
             RowBox[{"First", "@", "#2"}], "]"}]}]}], "}"}], ",", 
         RowBox[{"ContourPlot", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Im", "[", 
             RowBox[{"g", "[", 
              RowBox[{"x", "+", 
               RowBox[{"I", " ", "y"}]}], "]"}], "]"}], "==", "0"}], ",", 
           RowBox[{"{", 
            RowBox[{"x", ",", 
             RowBox[{"-", "R"}], ",", "R"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"y", ",", 
             RowBox[{"-", "R"}], ",", "R"}], "}"}], ",", 
           RowBox[{"RegionFunction", "->", 
            RowBox[{"Function", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"x", ",", "y"}], "}"}], ",", 
              RowBox[{"Module", "[", 
               RowBox[{
                RowBox[{"{", 
                 RowBox[{"w", "=", 
                  RowBox[{"g", "[", 
                   RowBox[{"x", "+", 
                    RowBox[{"I", " ", "y"}]}], "]"}]}], "}"}], ",", 
                RowBox[{
                 RowBox[{"w", "=!=", "Indeterminate"}], "&&", 
                 RowBox[{"w", "=!=", "ComplexInfinity"}], "&&", 
                 RowBox[{
                  RowBox[{"Abs", "[", "w", "]"}], ">", "eps"}], "&&", 
                 RowBox[{
                  RowBox[{"Re", "[", "w", "]"}], "<=", "0"}]}]}], "]"}]}], 
             "]"}]}], ",", 
           RowBox[{"ContourStyle", "->", 
            RowBox[{"Directive", "[", 
             RowBox[{"Thick", ",", "col"}], "]"}]}], ",", 
           RowBox[{"PlotPoints", "->", "pp"}], ",", 
           RowBox[{"MaxRecursion", "->", "mr"}]}], "]"}]}], "]"}], "&"}], ",",
       "args"}], "]"}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{"cuts", "=", 
  RowBox[{"Legended", "[", 
   RowBox[{
    RowBox[{"Show", "[", 
