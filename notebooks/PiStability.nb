 CellLabel->"In[72]:=",ExpressionUUID->"8a7e5ca4-2958-496d-8d6b-861a54135ac3"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", 
   RowBox[{"b", ",", "t"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{" ", 
  RowBox[{"With", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"m0", "=", "0"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"elPath", "[", "t_", "]"}], ":=", 
      RowBox[{"Exp", "[", 
       RowBox[{"2", "Pi", " ", "I", " ", 
        RowBox[{"(", 
         RowBox[{"3", 
          RowBox[{"(", 
           RowBox[{"m0", "+", 
            RowBox[{
             RowBox[{"1", "/", "3"}], "t"}]}], ")"}]}], ")"}]}], "]"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"res", "=", 
      RowBox[{"AnalyticContinuationOfRoots", "[", 
       RowBox[{
        RowBox[{"PolyEl", "[", 
         RowBox[{"b", ",", 
          RowBox[{"elPath", "[", "t", "]"}]}], "]"}], ",", " ", "b", ",", " ",
         "t", ",", " ", "0", ",", " ", "1.0", ",", " ", 
        RowBox[{"Steps", "->", "200"}]}], "]"}]}], ";"}]}], 
   "\[IndentingNewLine]", "]"}]}]}], "Input",
