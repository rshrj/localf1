Cell[BoxData[{
 RowBox[{
  RowBox[{"a1", "=", 
   RowBox[{"ComputeTransition2", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"-", "27"}], "/", "256"}], ",", " ", "upath", ",", " ", "512", ",",
      "5", ",", " ", 
     RowBox[{"WorkingPrecision", "->", "50"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"mon2", "=", " ", 
  RowBox[{
   RowBox[{"N", "[", 
    RowBox[{"Chop", "[", "a1", "]"}], "]"}], "\[Transpose]"}]}]}], "Input",
