Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", 
   RowBox[{"b", ",", "t"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{" ", 
  RowBox[{"With", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"m0", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"-", "1"}], "/", "10"}], "+", 
       RowBox[{"I", "/", "10"}]}]}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"elPath", "[", "t_", "]"}], ":=", 
      RowBox[{"Exp", "[", 
       RowBox[{"2", "Pi", " ", "I", " ", 
        RowBox[{"(", 
         RowBox[{"3", 
          RowBox[{"(", 
           RowBox[{"m0", "+", 
            RowBox[{
             RowBox[{"1", "/", "3"}], "t"}]}], ")"}]}], ")"}]}], "]"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"res", "=", 
      RowBox[{"AnalyticContinuationOfRoots", "[", 
       RowBox[{
        RowBox[{"PolyEl", "[", 
         RowBox[{"b", ",", 
          RowBox[{"elPath", "[", "t", "]"}]}], "]"}], ",", " ", "b", ",", " ",
         "t", ",", " ", "0", ",", " ", "1.0", ",", " ", 
        RowBox[{"Steps", "->", "200"}]}], "]"}]}], ";"}]}], 
   "\[IndentingNewLine]", "]"}]}]}], "Input",
 CellLabel->"In[83]:=",ExpressionUUID->"b26bef5b-5662-43f2-8d12-a2af081cf2d3"],

