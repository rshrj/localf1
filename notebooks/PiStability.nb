         RowBox[{
          RowBox[{"Head", "[", "ser", "]"}], "===", "SeriesData"}], ",", 
         RowBox[{"ser", "[", 
          RowBox[{"[", "4", "]"}], "]"}], ",", "0"}], "]"}]}]}], "]"}]}], 
   ";"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{"ClearAll", "[", "linearSolveRules", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"linearSolveRules", "[", 
     RowBox[{"eqs_List", ",", "vars_List"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "poly", ",", "ca", ",", "mat", ",", "vec", ",", "solvec", ",", "r"}], 
       "}"}], ",", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{
        "turn", " ", "eqs", " ", "into", " ", "linear", " ", "expressions"}], 
        "==", "0"}], "*)"}], 
      RowBox[{
       RowBox[{"poly", "=", 
        RowBox[{"(", 
         RowBox[{"eqs", "/.", " ", 
          RowBox[{"Equal", "->", "Subtract"}]}], ")"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"ca", "=", 
        RowBox[{"CoefficientArrays", "[", 
         RowBox[{"poly", ",", "vars"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"vec", "=", 
        RowBox[{"-", 
         RowBox[{"Normal", "[", 
          RowBox[{"ca", "[", 
           RowBox[{"[", "1", "]"}], "]"}], "]"}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"mat", "=", 
        RowBox[{"Normal", "[", 
         RowBox[{"ca", "[", 
          RowBox[{"[", "2", "]"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"Which", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"mat", "===", 
           RowBox[{"{", "}"}]}], "||", 
          RowBox[{"vars", "===", 
           RowBox[{"{", "}"}]}]}], ",", 
         RowBox[{"{", "}"}], ",", 
         RowBox[{
          RowBox[{
           RowBox[{"Dimensions", "[", "mat", "]"}], "[", 
           RowBox[{"[", "1", "]"}], "]"}], "===", 
          RowBox[{
           RowBox[{"Dimensions", "[", "mat", "]"}], "[", 
           RowBox[{"[", "2", "]"}], "]"}]}], ",", 
         RowBox[{
          RowBox[{"solvec", "=", 
           RowBox[{"LinearSolve", "[", 
            RowBox[{"mat", ",", "vec"}], "]"}]}], ";", "\[IndentingNewLine]", 
          
          RowBox[{"Thread", "[", 
           RowBox[{"vars", "->", "solvec"}], "]"}]}], ",", "True", ",", 
         RowBox[{"(*", 
          RowBox[{"overdetermined", "/", 
