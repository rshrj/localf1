    RowBox[{
     RowBox[{"Log", "[", "B", "]"}], 
     RowBox[{"Sum", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"dvec", "[", 
         RowBox[{"[", "j", "]"}], "]"}], 
