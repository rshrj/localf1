Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"el", "=", 
     RowBox[{
      RowBox[{"-", "27"}], "/", "256"}]}], "}"}], ",", "\[IndentingNewLine]", 
   
   RowBox[{
    RowBox[{"psi0", "=", 
     RowBox[{"N", "[", 
      RowBox[{
       RowBox[{"SystemMatrix2", "[", 
        RowBox[{
         RowBox[{"F1Series2", "[", 
          RowBox[{"el", ",", " ", 
           RowBox[{"upath1", "[", "0", "]"}], ",", " ", "512", ",", "5"}], 
          "]"}], ",", " ", "el", ",", " ", 
         RowBox[{"upath1", "[", "0", "]"}]}], "]"}], ",", "100"}], "]"}]}], ";",
     "\[IndentingNewLine]", 
    RowBox[{"a1", "=", 
     RowBox[{"NDSolve", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"Psi", "'"}], "[", "t", "]"}], "==", 
          RowBox[{
           RowBox[{
            RowBox[{"upath1", "'"}], "[", "t", "]"}], "*", 
           RowBox[{
            RowBox[{"PicardFuchsA2", "[", 
             RowBox[{"el", ",", 
              RowBox[{"upath1", "[", "t", "]"}]}], "]"}], ".", 
            RowBox[{"Psi", "[", "t", "]"}]}]}]}], ",", 
         RowBox[{
          RowBox[{"Psi", "[", "0", "]"}], "==", "psi0"}]}], "}"}], ",", "Psi",
        ",", 
       RowBox[{"{", 
        RowBox[{"t", ",", "0", ",", "1"}], "}"}], ",", 
       RowBox[{"WorkingPrecision", "->", "40"}], ",", 
       RowBox[{"MaxSteps", "->", 
        RowBox[{"10", "^", "7"}]}]}], "]"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"psi1", "=", 
     RowBox[{
      RowBox[{"Psi", "[", "1", "]"}], "/.", 
      RowBox[{"First", "[", "a1", "]"}]}]}], ";"}]}], "\[IndentingNewLine]", 
  "]"}]], "Input",
