Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"KerrDoranFormula", "[", 
    RowBox[{
    "avec_", ",", "bvec_", ",", "dvec_", ",", "evec_", ",", "A_", ",", "B_"}],
     "]"}], ":=", 
   RowBox[{
    RowBox[{"-", 
     RowBox[{"Sum", "[", 
      RowBox[{
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"avec", "[", 
           RowBox[{"[", "j", "]"}], "]"}], "===", 
          RowBox[{"bvec", "[", 
           RowBox[{"[", "k", "]"}], "]"}]}], ",", "0", ",", 
         RowBox[{
          RowBox[{"dvec", "[", 
           RowBox[{"[", "j", "]"}], "]"}], "*", 
          RowBox[{"evec", "[", 
           RowBox[{"[", "k", "]"}], "]"}], 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"Li2", "[", 
             RowBox[{
              RowBox[{"avec", "[", 
               RowBox[{"[", "j", "]"}], "]"}], "/", 
              RowBox[{"bvec", "[", 
               RowBox[{"[", "k", "]"}], "]"}]}], "]"}], "+", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{
               RowBox[{"Log", "[", 
                RowBox[{"avec", "[", 
                 RowBox[{"[", "j", "]"}], "]"}], "]"}], "-", 
               RowBox[{"Log", "[", 
                RowBox[{"bvec", "[", 
                 RowBox[{"[", "k", "]"}], "]"}], "]"}]}], ")"}], 
             RowBox[{"Log", "[", 
              RowBox[{"1", "-", 
               RowBox[{
                RowBox[{"avec", "[", 
                 RowBox[{"[", "j", "]"}], "]"}], "/", 
                RowBox[{"bvec", "[", 
                 RowBox[{"[", "k", "]"}], "]"}]}]}], "]"}]}]}], ")"}]}]}], 
        "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"j", ",", 
         RowBox[{"Length", "[", "dvec", "]"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"k", ",", 
         RowBox[{"Length", "[", "evec", "]"}]}], "}"}]}], "]"}]}], "-", 
    RowBox[{
     RowBox[{"Log", "[", "B", "]"}], 
     RowBox[{"Sum", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"dvec", "[", 
         RowBox[{"[", "j", "]"}], "]"}], 
        RowBox[{"Log", "[", 
         RowBox[{"avec", "[", 
          RowBox[{"[", "j", "]"}], "]"}], "]"}]}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"j", ",", 
         RowBox[{"Length", "[", "dvec", "]"}]}], "}"}]}], "]"}]}], "+", 
    RowBox[{
     RowBox[{"Log", "[", "A", "]"}], 
     RowBox[{"Sum", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"evec", "[", 
         RowBox[{"[", "k", "]"}], "]"}], 
        RowBox[{"Log", "[", 
         RowBox[{"bvec", "[", 
          RowBox[{"[", "k", "]"}], "]"}], "]"}]}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"k", ",", 
         RowBox[{"Length", "[", "evec", "]"}]}], "}"}]}], "]"}]}]}]}], 
  ";"}]], "Input",
