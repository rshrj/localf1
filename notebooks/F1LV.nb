Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"F1PeriodsNp", "[", 
    RowBox[{"\[Lambda]_", ",", "ut_", ",", "Nn_", ",", "Nr_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "varpi2tab", ",", "varpi3tab", ",", "varpi2resum", ",", "varpi3resum", ",",
        "varpi2", ",", "varpi3", ",", "k", ",", "l"}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"varpi2tab", "=", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"-", "1"}], "/", "ut"}], ")"}], "^", "n"}], " ", 
          RowBox[{"Sum", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"k", "=", 
              RowBox[{"n", "-", 
               RowBox[{"2", "l"}]}]}], ";", " ", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{
               RowBox[{
                RowBox[{"(", 
                 RowBox[{"k", "+", 
                  RowBox[{"2", "l"}]}], ")"}], "!"}], "/", 
               RowBox[{"(", 
                RowBox[{
                 RowBox[{
                  RowBox[{"(", "l", ")"}], "!"}], 
                 RowBox[{
                  RowBox[{"(", 
                   RowBox[{"k", "!"}], ")"}], "^", "2"}], 
                 RowBox[{
                  RowBox[{"(", 
                   RowBox[{"l", "-", "k"}], ")"}], "!"}]}], ")"}]}], 
              RowBox[{
               RowBox[{"\[Lambda]", "^", 
                RowBox[{"(", 
                 RowBox[{"l", "-", "k"}], ")"}]}], " ", "/", 
               RowBox[{"(", 
                RowBox[{"k", "+", 
                 RowBox[{"2", "l"}]}], ")"}]}]}]}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{"{", 
             RowBox[{"l", ",", "0", ",", 
              RowBox[{"Floor", "[", 
               RowBox[{"n", "/", "2"}], "]"}]}], "}"}]}], "]"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"n", ",", "1", ",", "Nn"}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"varpi3tab", "=", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"-", "1"}], "/", "ut"}], ")"}], "^", "n"}], " ", 
          RowBox[{"Sum", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"k", "=", 
              RowBox[{"n", "-", 
               RowBox[{"2", "l"}]}]}], ";", " ", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"\[Lambda]", "^", 
               RowBox[{"(", 
                RowBox[{"l", "-", "k"}], ")"}]}], 
              RowBox[{"(", 
               RowBox[{
                RowBox[{"If", "[", 
                 RowBox[{
                  RowBox[{"k", ">", "l"}], ",", 
                  FractionBox[
                   RowBox[{
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{"-", "1"}], ")"}], "^", 
                    RowBox[{"(", 
                    RowBox[{"k", "+", "l"}], ")"}]}], " ", 
                    RowBox[{"Gamma", "[", 
                    RowBox[{"k", "-", "l"}], "]"}], " ", 
                    RowBox[{"Gamma", "[", 
                    RowBox[{"1", "+", "k", "+", 
                    RowBox[{"2", " ", "l"}]}], "]"}]}], 
                   RowBox[{"4", " ", 
                    RowBox[{"(", 
                    RowBox[{"k", "+", 
                    RowBox[{"2", " ", "l"}]}], ")"}], " ", 
                    RowBox[{"l", "!"}], " ", 
                    SuperscriptBox[
                    RowBox[{"Gamma", "[", 
                    RowBox[{"1", "+", "k"}], "]"}], "2"]}]], ",", 
                  "\[IndentingNewLine]", 
                  RowBox[{
                   RowBox[{"0", " ", 
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"2", " ", 
                    RowBox[{"Log", "[", "ut", "]"}]}], "-", 
                    RowBox[{
                    RowBox[{"1", "/", "4"}], " ", 
                    RowBox[{"Log", "[", "\[Lambda]", "]"}]}]}], ")"}], 
                    RowBox[{
                    RowBox[{
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{"k", "+", 
                    RowBox[{"2", "l"}]}], ")"}], "!"}], "/", 
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"(", "l", ")"}], "!"}], 
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{"k", "!"}], ")"}], "^", "2"}], 
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{"l", "-", "k"}], ")"}], "!"}]}], ")"}]}], "/", 
                    RowBox[{"(", 
                    RowBox[{"k", "+", 
                    RowBox[{"2", "l"}]}], ")"}]}]}], "\[IndentingNewLine]", "+", 
                   RowBox[{"(", 
                    RowBox[{
                    RowBox[{"(", " ", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{"k", "+", 
                    RowBox[{"2", " ", "l"}]}], ")"}], "!"}], " ", 
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"4", " ", 
                    RowBox[{"HarmonicNumber", "[", "k", "]"}]}], "+", 
                    RowBox[{"3", " ", 
                    RowBox[{"HarmonicNumber", "[", "l", "]"}]}], "+", 
                    RowBox[{"HarmonicNumber", "[", 
                    RowBox[{
                    RowBox[{"-", "k"}], "+", "l"}], "]"}], "-", 
                    RowBox[{"8", " ", 
                    RowBox[{"HarmonicNumber", "[", 
                    RowBox[{"k", "+", 
                    RowBox[{"2", " ", "l"}]}], "]"}]}]}], ")"}]}], ")"}], "/", 
                    RowBox[{"(", 
                    RowBox[{"4", " ", 
                    RowBox[{"(", 
                    RowBox[{"k", "+", 
                    RowBox[{"2", " ", "l"}]}], ")"}], " ", 
                    SuperscriptBox[
                    RowBox[{"(", 
                    RowBox[{"k", "!"}], ")"}], "2"], " ", 
