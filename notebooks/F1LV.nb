Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "RichardsonResum", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"RichardsonResum", "[", 
    RowBox[{"PartSum_", ",", "n_"}], "]"}], ":=", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"d", "=", 
       RowBox[{
        RowBox[{"Length", "[", "PartSum", "]"}], "-", "n", "-", "1"}]}], 
      "}"}], ",", 
     RowBox[{"Sum", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"PartSum", "[", 
         RowBox[{"[", 
          RowBox[{
           RowBox[{"Length", "[", "PartSum", "]"}], "+", "k", "-", "n"}], 
          "]"}], "]"}], 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"d", "+", "k"}], ")"}], "^", "n"}], 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"-", "1"}], ")"}], "^", 
           RowBox[{"(", 
            RowBox[{"k", "+", "n"}], ")"}]}], "/", 
          RowBox[{"k", "!"}]}], "/", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"n", "-", "k"}], ")"}], "!"}]}]}], ",", 
       RowBox[{"{", 
        RowBox[{"k", ",", "0", ",", "n"}], "}"}]}], "]"}]}], "]"}]}], 
  ";"}]}], "Input",
