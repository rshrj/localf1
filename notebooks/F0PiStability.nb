  RowBox[{
   RowBox[{
    RowBox[{"repoRoot", "=", 
     RowBox[{"ParentDirectory", "@", 
      RowBox[{"NotebookDirectory", "[", "]"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"repoAppDir", "=", 
     RowBox[{"FileNameJoin", "[", 
      RowBox[{"{", 
       RowBox[{"repoRoot", ",", "\"\<mma\>\""}], "}"}], "]"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"!", 
       RowBox[{"MemberQ", "[", 
        RowBox[{"$Path", ",", "repoAppDir"}], "]"}]}], ",", 
      RowBox[{
       RowBox[{"AppendTo", "[", 
        RowBox[{"$Path", ",", "repoAppDir"}], "]"}], ";"}]}], "]"}], ";"}], 
