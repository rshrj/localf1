Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"plotData", "=", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<coll\>\"", "->", "CollBridgeland"}], ",", " ", 
       RowBox[{"\"\<mB\>\"", "->", 
        RowBox[{"Function", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"m", ",", "mu"}], "}"}], ",", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"2", "m"}], "+", 
             RowBox[{"3", "mu"}], "-", "1"}], ")"}], "/", "3"}]}], "]"}]}], ",",
        " ", 
       RowBox[{"\"\<color\>\"", "->", 
        TemplateBox[<|"color" -> RGBColor[0, 0.8260000000000001, 1]|>,
         "RGBColorSwatchTemplate"]}]}], "|>"}], ",", "\[IndentingNewLine]", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<coll\>\"", "->", "CollArcaraI"}], ",", " ", 
       RowBox[{"\"\<mB\>\"", "->", 
        RowBox[{"Function", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"m", ",", "mu"}], "}"}], ",", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"2", "m"}], "+", 
             RowBox[{"3", "mu"}], "-", "3"}], ")"}], "/", "3"}]}], "]"}]}], ",",
        " ", 
       RowBox[{"\"\<color\>\"", "->", 
        TemplateBox[<|"color" -> RGBColor[0.46900000000000003`, 1, 0]|>,
         "RGBColorSwatchTemplate"]}]}], "|>"}], ",", "\[IndentingNewLine]", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<coll\>\"", "->", "CollArcaraII"}], ",", " ", 
       RowBox[{"\"\<mB\>\"", "->", 
        RowBox[{"Function", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"m", ",", "mu"}], "}"}], ",", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"2", "m"}], "+", 
             RowBox[{"3", "mu"}], "-", "1"}], ")"}], "/", "3"}]}], "]"}]}], ",",
        " ", 
       RowBox[{"\"\<color\>\"", "->", 
        TemplateBox[<|"color" -> RGBColor[1, 0, 0.192]|>,
         "RGBColorSwatchTemplate"]}]}], "|>"}]}], "\[IndentingNewLine]", 
    "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"mu", "=", "0"}], ",", " ", 
     RowBox[{"L", "=", "4"}], ",", " ", 
     RowBox[{"Lp", "=", "6"}], ",", 
     RowBox[{"len", "=", "20"}]}], "}"}], ",", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"constructDomain", "[", "asc_", "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", "ineq", "}"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"ineq", "=", 
         RowBox[{"Table", "[", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"IntegerQ", "[", 
              RowBox[{
               RowBox[{"asc", "[", "\"\<mB\>\"", "]"}], "[", 
               RowBox[{"mF", ",", "mu"}], "]"}], "]"}], ",", "Nothing", ",", 
             "\[IndentingNewLine]", 
             RowBox[{"CollInequalities", "[", 
              RowBox[{
               RowBox[{"SpectralFlow", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{"asc", "[", "\"\<coll\>\"", "]"}], "/.", "repCh"}], 
                 ",", " ", 
                 RowBox[{"{", 
                  RowBox[{"mF", ",", 
                   RowBox[{"Ceiling", "[", 
                    RowBox[{
                    RowBox[{"asc", "[", "\"\<mB\>\"", "]"}], "[", 
                    RowBox[{"mF", ",", "mu"}], "]"}], "]"}]}], "}"}]}], "]"}],
                ",", 
               RowBox[{"{", 
                RowBox[{"x", ",", "y"}], "}"}], ",", "mu"}], "]"}]}], "]"}], ",",
            " ", 
           RowBox[{"{", 
            RowBox[{"mF", ",", " ", 
             RowBox[{"-", "L"}], ",", "L"}], "}"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"EdgeForm", "[", 
           RowBox[{"Opacity", "[", 
            RowBox[{".25", ",", 
             RowBox[{"asc", "[", "\"\<color\>\"", "]"}]}], "]"}], "]"}], ",", 
          " ", 
          RowBox[{
           RowBox[{
            RowBox[{"DiscretizeRegion", "[", 
             RowBox[{"ImplicitRegion", "[", 
              RowBox[{
               RowBox[{"And", "@@", "#"}], ",", 
               RowBox[{"{", 
                RowBox[{"x", ",", "y"}], "}"}]}], "]"}], "]"}], "&"}], "/@", 
           "ineq"}]}], "}"}]}]}], "\[IndentingNewLine]", "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"rays", "=", 
     RowBox[{"Flatten", "[", 
      RowBox[{
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"{", 
            RowBox[{"#", ",", " ", 
             RowBox[{"InitialPositionXY", "[", 
              RowBox[{"#", ",", " ", "mu"}], "]"}], ",", "0", ",", "0", ",", 
             "0", ",", "0", ",", "0"}], "}"}], "&"}], "[", 
          RowBox[{
           RowBox[{"s", " ", 
            RowBox[{"Ch", "[", 
             RowBox[{"p", ",", "q"}], "]"}]}], "/.", "repCh"}], "]"}], ",", 
         " ", 
         RowBox[{"{", 
          RowBox[{"p", ",", 
           RowBox[{"-", "Lp"}], ",", "Lp"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"q", ",", 
           RowBox[{"-", "Lp"}], ",", "Lp"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"s", ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"-", "1"}], ",", "1"}], "}"}]}], "}"}]}], "]"}], ",", 
       " ", "2"}], "]"}]}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{"Show", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Plot", "[", 
       RowBox[{
        RowBox[{"XYParabolaY", "[", 
         RowBox[{"x", ",", "mu", ",", "0", ",", "0"}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"x", ",", 
          RowBox[{"-", "2"}], ",", "2"}], "}"}], ",", "\[IndentingNewLine]", 
        RowBox[{"PlotRange", "->", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"-", "1"}], ",", "1"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"-", "5"}], ",", "2"}], "}"}]}], "}"}]}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"PlotStyle", "->", 
         RowBox[{"Directive", "[", 
          RowBox[{"Dashed", ",", "Thick", ",", "Black"}], "]"}]}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"GridLines", "->", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"-", "0.2"}], ",", "1.2"}], "}"}], ",", "None"}], 
          "}"}]}]}], "\[IndentingNewLine]", "]"}], ",", "\[IndentingNewLine]", 
      RowBox[{"Graphics", "[", 
       RowBox[{"{", 
        RowBox[{
