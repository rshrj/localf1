Cell[BoxData[{
 RowBox[{
  RowBox[{"charges", "=", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"L", "=", "5"}], "}"}], ",", 
     RowBox[{"Flatten", "[", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"s", " ", 
         RowBox[{"Ch", "[", 
          RowBox[{"p", ",", "q"}], "]"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"p", ",", 
          RowBox[{"-", "L"}], ",", "L"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"q", ",", 
          RowBox[{"-", "L"}], ",", "L"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"s", ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", "1"}], ",", "1"}], "}"}]}], "}"}]}], "]"}], "]"}]}], 
    "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"m", "=", "0"}], ",", " ", 
     RowBox[{"psi", "=", "0"}], ",", " ", 
     RowBox[{"xmin", "=", 
      RowBox[{"-", "1"}]}], ",", " ", 
     RowBox[{"xmax", "=", "2"}], ",", " ", 
     RowBox[{"tmax", "=", "0.5"}]}], "}"}], ",", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"charges", "=", 
     RowBox[{"Select", "[", 
      RowBox[{"charges", ",", " ", 
       RowBox[{
        RowBox[{"xmin", "<=", 
         RowBox[{"Rays", "[", 
          RowBox[{
           RowBox[{"#", "/.", "repCh"}], ",", "0", ",", "psi", ",", "m"}], 
          "]"}], "<=", "xmax"}], "&"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"(*", " ", 
     RowBox[{"add", " ", "Rank", " ", "0", " ", "sheaf"}], " ", "*)"}], 
    "\[IndentingNewLine]", 
    RowBox[{"AppendTo", "[", 
     RowBox[{"charges", ",", 
      RowBox[{"GV", "[", 
       RowBox[{"0", ",", 
        RowBox[{"-", "1"}], ",", 
        RowBox[{
         RowBox[{"-", "1"}], "/", "2"}]}], "]"}]}], "]"}], ";", 
    "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{"(*", " ", 
     RowBox[{"compute", " ", "rays", " ", "and", " ", "captions"}], " ", 
     "*)"}], "\[IndentingNewLine]", 
    RowBox[{"rays", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Tooltip", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Rays", "[", 
            RowBox[{
             RowBox[{"g", "/.", "repCh"}], ",", " ", "t", ",", "psi", ",", 
             "m"}], "]"}], ",", " ", "t"}], "}"}], ",", " ", "g"}], "]"}], ",",
        " ", 
       RowBox[{"{", 
        RowBox[{"g", ",", " ", "charges"}], "}"}]}], "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"captions", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"GamCaption", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"RandomReal", "[", 
          RowBox[{"{", 
           RowBox[{".2", ",", ".4"}], "}"}], "]"}], ",", "psi", ",", "m"}], 
        "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"g", ",", " ", "charges"}], "}"}]}], "]"}]}], ";", 
    "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{"(*", " ", 
     RowBox[{"compute", " ", "quiver", " ", "domains"}], " ", "*)"}], 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"CollDom", "[", 
      RowBox[{"Coll_", ",", " ", "Color_"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", "possibleSpecParams", "}"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"possibleSpecParams", " ", "=", " ", 
         RowBox[{"Echo", "@", 
          RowBox[{"ListSpecFlows", "[", 
           RowBox[{
           "Coll", ",", " ", "psi", ",", " ", "m", ",", " ", "12", ",", " ", 
            "xmin", ",", " ", "xmax", ",", " ", "tmax"}], "]"}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"QuiverDomain", "[", 
           RowBox[{
            RowBox[{"SpectralFlow", "[", 
             RowBox[{"Coll", ",", " ", "spec"}], "]"}], ",", "psi", ",", "m", 
            ",", 
            RowBox[{"PlotStyle", "->", "Color"}], ",", 
            RowBox[{"PlotRange", "->", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"xmin", ",", "xmax"}], "}"}], ",", 
               RowBox[{"{", 
                RowBox[{"0", ",", "tmax"}], "}"}]}], "}"}]}], ",", " ", 
            RowBox[{"PlotPoints", "->", "100"}]}], "]"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"spec", ",", "possibleSpecParams"}], "}"}]}], "]"}]}]}], 
      "\[IndentingNewLine]", "]"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"PrintTemporary", "[", "\"\<Computing domainI\>\"", "]"}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"domainI", " ", "=", " ", 
     RowBox[{"CollDom", "[", 
      RowBox[{"CollArcaraI", ",", " ", "LightGreen"}], "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"PrintTemporary", "[", "\"\<Computing domainII\>\"", "]"}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"domainII", " ", "=", " ", 
     RowBox[{"CollDom", "[", 
      RowBox[{"CollArcaraII", ",", " ", "LightRed"}], "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"PrintTemporary", "[", "\"\<Computing domainBr\>\"", "]"}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"domainBr", " ", "=", " ", 
     RowBox[{"CollDom", "[", 
      RowBox[{"CollBridgeland", ",", " ", "LightBlue"}], "]"}]}], ";", 
    "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{"plt1", "=", 
     RowBox[{"Show", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"ParametricPlot", "[", 
        RowBox[{"rays", ",", " ", 
         RowBox[{"{", 
          RowBox[{"t", ",", "0", ",", "0.5"}], "}"}], ",", 
