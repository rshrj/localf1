      RowBox[{"{", 
       RowBox[{
        RowBox[{"Nn", "=", "200"}], ",", " ", 
        RowBox[{"d", "=", "5"}]}], "}"}], ",", " ", 
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"terms", ",", "sums"}], "}"}], ",", " ", 
        "\[IndentingNewLine]", 
