              RowBox[{
               RowBox[{
                RowBox[{
                 RowBox[{
                  RowBox[{
                   RowBox[{"(", 
                    RowBox[{
                    RowBox[{"2", "n"}], "-", "1"}], ")"}], "!"}], "/", 
                  RowBox[{
                   RowBox[{"Factorial", "[", 
                    RowBox[{"n", "-", "l"}], "]"}], "^", "2"}]}], "/", 
