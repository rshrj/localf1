                RowBox[{"l", ",", "0", ",", "n"}], "}"}]}], "]"}], 
             RowBox[{"z", "^", "n"}]}], ",", " ", 
            RowBox[{"{", 
             RowBox[{"n", ",", " ", "1", ",", " ", "Nn"}], "}"}]}], "]"}]}], ";",
          "\[IndentingNewLine]", 
         RowBox[{"sums", "=", 
          RowBox[{
           RowBox[{"Log", "[", "z", "]"}], "+", 
           RowBox[{"2", 
            RowBox[{"Accumulate", "[", "terms", "]"}]}]}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"Sum", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"sums", "[", 
               RowBox[{"[", 
                RowBox[{"n", "+", "k"}], "]"}], "]"}], 
              RowBox[{
               RowBox[{"(", 
                RowBox[{"n", "+", "k"}], ")"}], "^", "d"}], 
              RowBox[{
               RowBox[{
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{"-", "1"}], ")"}], "^", 
