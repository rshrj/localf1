        RowBox[{"DSZ", "[", 
         RowBox[{"ch1", ",", "ch2"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"rays", "=", 
       RowBox[{"XYFan", "[", 
        RowBox[{"ch1", ",", "ch2", ",", "m", ",", "Nr"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
