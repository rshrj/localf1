Cell[BoxData[{
 RowBox[{
  RowBox[{"charges", "=", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"L", "=", "5"}], "}"}], ",", 
     RowBox[{"Flatten", "[", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"s", " ", 
         RowBox[{"Ch", "[", 
          RowBox[{"p", ",", "q"}], "]"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"p", ",", 
          RowBox[{"-", "L"}], ",", "L"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"q", ",", 
          RowBox[{"-", "L"}], ",", "L"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"s", ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", "1"}], ",", "1"}], "}"}]}], "}"}]}], "]"}], "]"}]}], 
    "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"m", "=", 
      RowBox[{"1", "/", "10"}]}], ",", " ", 
     RowBox[{"psi", "=", "0"}], ",", " ", 
     RowBox[{"xmin", "=", 
      RowBox[{"-", "0.2"}]}], ",", " ", 
     RowBox[{"xmax", "=", "1.2"}], ",", " ", 
     RowBox[{"tmax", "=", "0.5"}]}], "}"}], ",", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"charges", "=", 
     RowBox[{"Select", "[", 
      RowBox[{"charges", ",", " ", 
       RowBox[{
        RowBox[{"xmin", "<=", 
         RowBox[{"Rays", "[", 
          RowBox[{
           RowBox[{"#", "/.", "repCh"}], ",", "0", ",", "psi", ",", "m"}], 
          "]"}], "<=", "xmax"}], "&"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"(*", " ", 
     RowBox[{"add", " ", "Rank", " ", "0", " ", "sheaf"}], " ", "*)"}], 
    "\[IndentingNewLine]", 
    RowBox[{"AppendTo", "[", 
     RowBox[{"charges", ",", 
      RowBox[{"GV", "[", 
       RowBox[{"0", ",", 
        RowBox[{"-", "1"}], ",", 
        RowBox[{
         RowBox[{"-", "1"}], "/", "2"}]}], "]"}]}], "]"}], ";", 
    "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{"(*", " ", 
     RowBox[{"compute", " ", "rays", " ", "and", " ", "captions"}], " ", 
     "*)"}], "\[IndentingNewLine]", 
