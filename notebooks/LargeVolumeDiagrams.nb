Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{
    "sInitials", ",", "levelInitials", ",", "integerValuedQ", ",", 
     "validLevelQ", ",", "goodSamplePoint", ",", "decoratePlot"}], "]"}], 
   ";"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"sInitials", "[", 
    RowBox[{"gam_", ",", " ", 
     RowBox[{"m_", "?", "NumericQ"}]}], "]"}], ":=", 
   RowBox[{
    RowBox[{"Initials", "[", 
     RowBox[{
      RowBox[{"gam", "/.", " ", "repCh"}], ",", "m", ",", 
      RowBox[{"\"\<Verbose\>\"", "->", "False"}]}], "]"}], "[", 
    RowBox[{"[", "1", "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"levelInitials", "[", 
     RowBox[{"gam_", ",", " ", 
      RowBox[{"m_", "?", "NumericQ"}]}], "]"}], ":=", 
    RowBox[{
     RowBox[{"Initials", "[", 
      RowBox[{
       RowBox[{"gam", "/.", " ", "repCh"}], ",", "m", ",", 
       RowBox[{"\"\<Verbose\>\"", "->", "False"}]}], "]"}], "[", 
     RowBox[{"[", "2", "]"}], "]"}]}], ";"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"integerValuedQ", "[", "x_", "]"}], ":=", 
    RowBox[{
     RowBox[{"IntegerQ", "[", "x", "]"}], "||", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"NumericQ", "[", "x", "]"}], "&&", 
       RowBox[{"x", "==", 
        RowBox[{"Round", "[", "x", "]"}]}]}], ")"}]}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"validLevelQ", "[", 
     RowBox[{"gam_", ",", 
      RowBox[{"x_", "?", "NumericQ"}]}], "]"}], ":=", 
    RowBox[{"integerValuedQ", "[", 
     RowBox[{"Quiet", "[", 
      RowBox[{"levelInitials", "[", 
       RowBox[{"gam", ",", " ", "x"}], "]"}], "]"}], "]"}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"goodSamplePoint", "[", 
     RowBox[{"gam_", ",", " ", 
      RowBox[{"{", 
       RowBox[{"a_", ",", "b_"}], "}"}]}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"mid", ",", "h", ",", "offsets", ",", "pts"}], "}"}], ",", 
      RowBox[{
       RowBox[{"mid", "=", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"a", "+", "b"}], ")"}], "/", "2"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"h", "=", 
        RowBox[{"b", "-", "a"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"offsets", "=", 
        RowBox[{"SortBy", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"-", "1"}], ",", "1", ",", 
             RowBox[{"-", "2"}], ",", "2", ",", 
             RowBox[{"-", "3"}], ",", "3", ",", 
             RowBox[{"-", "4"}], ",", "4"}], "}"}], "/", "100"}], ",", 
          "Abs"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"pts", "=", 
        RowBox[{"mid", "+", 
         RowBox[{"h", "*", "offsets"}]}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"pts", "=", 
        RowBox[{"Select", "[", 
         RowBox[{"pts", ",", 
          RowBox[{
           RowBox[{
            RowBox[{"a", "<", "#", "<", "b"}], "&&", 
            RowBox[{"validLevelQ", "[", 
             RowBox[{"gam", ",", " ", "#"}], "]"}]}], "&"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"pts", "===", 
          RowBox[{"{", "}"}]}], ",", 
         RowBox[{"Missing", "[", "\"\<NoGoodSample\>\"", "]"}], ",", 
         RowBox[{"First", "[", "pts", "]"}]}], "]"}]}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Options", "[", "decoratePlot", "]"}], "=", 
   RowBox[{"{", 
    RowBox[{"\"\<Color\>\"", "->", 
     RowBox[{"ColorData", "[", 
      RowBox[{"97", ",", "1"}], "]"}]}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"decoratePlot", "[", 
    RowBox[{"gam_", ",", " ", "mmin_", ",", "mmax_", ",", " ", 
     RowBox[{"OptionsPattern", "[", "]"}]}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"eps", "=", 
        RowBox[{"10", "^", 
         RowBox[{"-", "6"}]}]}], ",", 
       RowBox[{"gap", "=", ".03"}], ",", "candidates", ",", "baseCuts", ",", 
       "allCuts", ",", "intervals", ",", "validIntervals", ",", "pieces", ",",
        "labels", ",", "endpoints"}], "}"}], ",", 
     RowBox[{"(*", 
      RowBox[{"all", " ", "possible", " ", "special", " ", "points", " ", 
       RowBox[{"n", "/", "3"}], " ", "inside", " ", "the", " ", "plotting", " ",
        "window"}], "*)"}], "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"candidates", "=", 
       RowBox[{"Select", "[", 
        RowBox[{
         RowBox[{"Range", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Ceiling", "[", 
             RowBox[{"3", " ", "mmin"}], "]"}], "/", "3"}], ",", 
           RowBox[{
            RowBox[{"Floor", "[", 
             RowBox[{"3", " ", "mmax"}], "]"}], "/", "3"}], ",", 
           RowBox[{"1", "/", "3"}]}], "]"}], ",", 
         RowBox[{
          RowBox[{"mmin", "<", "#", "<", "mmax"}], "&"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
       "cut", " ", "either", " ", "where", " ", "validity", " ", "changes", " ",
         "or", " ", "where", " ", "the", " ", "integer", " ", "level", " ", 
        "jumps"}], "*)"}], 
      RowBox[{"baseCuts", "=", 
       RowBox[{"Select", "[", 
        RowBox[{"candidates", ",", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"Quiet", "[", 
             RowBox[{"validLevelQ", "[", 
              RowBox[{"gam", ",", " ", 
               RowBox[{"#", "-", "eps"}]}], "]"}], "]"}], "=!=", 
            RowBox[{"Quiet", "[", 
             RowBox[{"validLevelQ", "[", 
              RowBox[{"gam", ",", " ", 
               RowBox[{"#", "+", "eps"}]}], "]"}], "]"}]}], "||", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"validLevelQ", "[", 
              RowBox[{"gam", ",", " ", 
               RowBox[{"#", "-", "eps"}]}], "]"}], "&&", 
             RowBox[{"validLevelQ", "[", 
              RowBox[{"gam", ",", " ", 
               RowBox[{"#", "+", "eps"}]}], "]"}], "&&", 
             RowBox[{
              RowBox[{"Quiet", "[", 
               RowBox[{"levelInitials", "[", 
                RowBox[{"gam", ",", " ", 
                 RowBox[{"#", "-", "eps"}]}], "]"}], "]"}], "=!=", 
              RowBox[{"Quiet", "[", 
               RowBox[{"levelInitials", "[", 
                RowBox[{"gam", ",", " ", 
                 RowBox[{"#", "+", "eps"}]}], "]"}], "]"}]}]}], ")"}]}], 
          "&"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"allCuts", "=", 
       RowBox[{"Sort", "@", 
        RowBox[{"DeleteDuplicates", "@", 
         RowBox[{"Join", "[", 
          RowBox[{
           RowBox[{"{", "mmin", "}"}], ",", "baseCuts", ",", 
           RowBox[{"{", "mmax", "}"}]}], "]"}]}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"intervals", "=", 
       RowBox[{"Partition", "[", 
        RowBox[{"allCuts", ",", "2", ",", "1"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
       "keep", " ", "only", " ", "intervals", " ", "that", " ", "contain", " ",
         "at", " ", "least", " ", "one", " ", "safe", " ", "interior", " ", 
        "sample", " ", "point"}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{"validIntervals", "=", 
       RowBox[{"Select", "[", 
        RowBox[{"intervals", ",", 
         RowBox[{
          RowBox[{
           RowBox[{"goodSamplePoint", "[", 
            RowBox[{"gam", ",", " ", "#"}], "]"}], "=!=", 
           RowBox[{"Missing", "[", "\"\<NoGoodSample\>\"", "]"}]}], "&"}]}], 
        "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"pieces", "=", 
       RowBox[{"Map", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Module", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"a", "=", 
               RowBox[{"#", "[", 
                RowBox[{"[", "1", "]"}], "]"}]}], ",", 
              RowBox[{"b", "=", 
               RowBox[{"#", "[", 
                RowBox[{"[", "2", "]"}], "]"}]}], ",", "g"}], "}"}], ",", 
            RowBox[{
             RowBox[{"g", "=", 
              RowBox[{"Min", "[", 
               RowBox[{"gap", ",", 
                RowBox[{"N", "[", 
                 RowBox[{
                  RowBox[{"(", 
                   RowBox[{"b", "-", "a"}], ")"}], "/", "10"}], "]"}]}], 
               "]"}]}], ";", "\[IndentingNewLine]", 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"a", "+", "g"}], "<", 
                RowBox[{"b", "-", "g"}]}], ",", 
               RowBox[{"Plot", "[", 
                RowBox[{
                 RowBox[{"sInitials", "[", 
                  RowBox[{"gam", ",", " ", "m"}], "]"}], ",", 
                 RowBox[{"{", 
                  RowBox[{"m", ",", 
                   RowBox[{"N", "[", 
                    RowBox[{"a", "+", "g"}], "]"}], ",", 
                   RowBox[{"N", "[", 
                    RowBox[{"b", "-", "g"}], "]"}]}], "}"}], ",", 
                 RowBox[{"PlotStyle", "->", 
                  RowBox[{"{", 
                   RowBox[{
                    RowBox[{"OptionValue", "[", "\"\<Color\>\"", "]"}], ",", 
                    RowBox[{"Thickness", "[", ".0055", "]"}]}], "}"}]}], ",", 
                 
                 RowBox[{"PlotRange", "->", "All"}]}], "]"}], ",", 
               "Nothing"}], "]"}]}]}], "]"}], "&"}], ",", "validIntervals"}], 
        "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"labels", "=", 
       RowBox[{"Map", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Module", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"x", "=", 
               RowBox[{"goodSamplePoint", "[", 
                RowBox[{"gam", ",", " ", "#"}], "]"}]}], ",", "lev"}], "}"}], 
            ",", 
            RowBox[{
             RowBox[{"lev", "=", 
              RowBox[{"levelInitials", "[", 
               RowBox[{"gam", ",", " ", "x"}], "]"}]}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"Text", "[", 
              RowBox[{
               RowBox[{"Style", "[", 
                RowBox[{
                 RowBox[{"\"\<k=\>\"", "<>", 
                  RowBox[{"ToString", "[", 
                   RowBox[{"Round", "[", "lev", "]"}], "]"}]}], ",", "13", ",",
                  "Black", ",", 
                 RowBox[{"Background", "->", "White"}], ",", 
                 RowBox[{"FontFamily", "->", "\"\<CMU Sans Serif\>\""}]}], 
                "]"}], ",", 
               RowBox[{"{", 
                RowBox[{"x", ",", 
                 RowBox[{"sInitials", "[", 
                  RowBox[{"gam", ",", " ", "x"}], "]"}]}], "}"}], ",", 
               RowBox[{"{", 
                RowBox[{"0", ",", 
                 RowBox[{"-", "1.5"}]}], "}"}]}], "]"}]}]}], "]"}], "&"}], ",",
          "validIntervals"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"endpoints", "=", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"EdgeForm", "[", 
          RowBox[{"{", 
           RowBox[{"Black", ",", 
            RowBox[{"Thickness", "[", ".003", "]"}]}], "}"}], "]"}], ",", " ",
          "White", ",", 
         RowBox[{
          RowBox[{
           RowBox[{"Disk", "[", 
            RowBox[{"#", ",", " ", ".03"}], "]"}], "&"}], "/@", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"{", 
              RowBox[{"#", ",", 
               RowBox[{"sInitials", "[", 
                RowBox[{"gam", ",", "#"}], "]"}]}], "}"}], "&"}], "/@", 
            RowBox[{"validIntervals", "[", 
             RowBox[{"[", 
              RowBox[{
               RowBox[{";;", 
                RowBox[{"-", "2"}]}], ",", "2"}], "]"}], "]"}]}], ")"}]}]}], 
