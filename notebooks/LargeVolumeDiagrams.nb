Cell[BoxData[
 RowBox[{
  RowBox[{"ticks", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"Thread", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"#", "/.", 
         RowBox[{"m", "->", 
          RowBox[{"1", "/", "10"}]}]}], ",", " ", 
