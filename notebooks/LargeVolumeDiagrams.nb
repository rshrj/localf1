Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", 
   RowBox[{"AsBr", ",", "AsAI", ",", "AsAII"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"AsBr", "[", "m_", "]"}], ":=", 
   RowBox[{"<|", 
    RowBox[{
     RowBox[{"\"\<Coll\>\"", "->", "CollBridgeland"}], ",", " ", 
     RowBox[{"\"\<SpectralFlows\>\"", "->", 
