Cell[BoxData[
 RowBox[{"(*", 
  RowBox[{
   RowBox[{"ClearAll", "[", "sameNumQ", "]"}], ";", "\n", 
   RowBox[{
    RowBox[{"sameNumQ", "[", 
     RowBox[{"a_", ",", "b_", ",", 
      RowBox[{"tol_", ":", 
       RowBox[{"10", "^", 
        RowBox[{"-", "12"}]}]}]}], "]"}], ":=", 
    RowBox[{"TrueQ", "[", 
     RowBox[{
      RowBox[{"Chop", "[", 
