Cell[BoxData[
 RowBox[{
  RowBox[{"ticks", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"Thread", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"#", "/.", 
         RowBox[{"m", "->", 
          RowBox[{
           RowBox[{"-", "1"}], "/", "10"}]}]}], ",", " ", 
        RowBox[{"MaTeX", "[", 
         RowBox[{"Simplify", "[", "#", "]"}], "]"}]}], "}"}], "]"}], "&"}], "@", 
    RowBox[{"Flatten", "[", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"m", "+", "k"}], ")"}], "/", "4"}], ",", " ", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"k", "-", "m"}], ")"}], "/", "2"}], ",", " ", 
         RowBox[{
          RowBox[{
           RowBox[{"-", "1"}], "/", "2"}], "-", "k", "+", "m"}]}], "}"}], ",",
        " ", 
       RowBox[{"{", 
        RowBox[{"k", ",", 
         RowBox[{"-", "5"}], ",", "5"}], "}"}]}], "]"}], "]"}]}]}], 
  ";"}]], "Input",
 CellChangeTimes->{3.97851286486806*^9},
 CellLabel->
  "In[483]:=",ExpressionUUID->"9ba8f411-5d9e-4c22-b960-c325eed5581e"],

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"m", "=", 
      RowBox[{
       RowBox[{"-", "1"}], "/", "10"}]}], ",", " ", 
     RowBox[{"psi", "=", "0"}], ",", " ", 
     RowBox[{"coll", "=", 
      RowBox[{"CollInitial", "[", 
       RowBox[{"[", "3", "]"}], "]"}]}], ",", " ", 
     RowBox[{"L", "=", "5"}], ",", " ", 
     RowBox[{"xmin", "=", 
      RowBox[{"-", "1"}]}], ",", " ", 
     RowBox[{"xmax", "=", "2"}]}], "}"}], ",", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"charges", "=", 
     RowBox[{"Flatten", "[", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"s", " ", "gam"}], "/.", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Ch", "[", 
            RowBox[{"p_", ",", "q_"}], "]"}], ":>", 
           RowBox[{"Ch", "[", 
            RowBox[{
             RowBox[{"p", "+", 
              RowBox[{"3", "k"}]}], ",", 
             RowBox[{"q", "+", 
              RowBox[{"2", "k"}]}]}], "]"}]}], "}"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"gam", ",", " ", "coll"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"k", ",", 
          RowBox[{"-", "L"}], ",", "L"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"s", ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", "1"}], ",", "1"}], "}"}]}], "}"}]}], "]"}], "]"}]}], 
    ";", "\[IndentingNewLine]", 
    RowBox[{"charges", "=", 
     RowBox[{"Join", "[", 
      RowBox[{"charges", ",", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"GV", "[", 
          RowBox[{"0", ",", "1", ",", 
           RowBox[{
            RowBox[{
             RowBox[{"-", "1"}], "/", "2"}], "-", "k"}]}], "]"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"k", ",", 
           RowBox[{"-", "L"}], ",", "L"}], "}"}]}], "]"}]}], "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"charges", "=", 
