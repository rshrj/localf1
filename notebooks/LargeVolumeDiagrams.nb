 RowBox[{
  RowBox[{
   RowBox[{"XYFanRays", "[", 
    RowBox[{"ch1_", ",", " ", "ch2_", ",", " ", "m_", ",", " ", 
     RowBox[{"Nr_", ":", "10"}], ",", " ", 
