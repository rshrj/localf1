Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"XYFan", "[", 
    RowBox[{"ch1_", ",", " ", "ch2_", ",", "m_", ",", " ", 
     RowBox[{"Nr_", ":", "10"}]}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"kap", ",", "inter", ",", "dims"}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"inter", " ", "=", " ", 
       RowBox[{"NaiveIntersection", "[", 
        RowBox[{"ch1", ",", "ch2", ",", " ", "m"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"kap", "=", 
       RowBox[{"Abs", "@", 
        RowBox[{"DSZ", "[", 
         RowBox[{"ch1", ",", "ch2"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"dims", "=", 
       RowBox[{"Join", "[", 
        RowBox[{
         RowBox[{"KroneckerDims", "[", 
          RowBox[{"kap", ",", " ", "Nr"}], "]"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"1", ",", "0"}], "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"0", ",", "1"}], "}"}]}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"d", ".", 
           RowBox[{"{", 
            RowBox[{"ch1", ",", "ch2"}], "}"}]}], ",", " ", "inter", ",", " ",
           "0", ",", "0", ",", "0", ",", "0", ",", "1"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"d", ",", " ", "dims"}], "}"}]}], "]"}]}]}], 
    "\[IndentingNewLine]", "]"}]}], ";"}]], "Input",
