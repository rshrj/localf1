Cell[BoxData[{
 RowBox[{
  RowBox[{"ch", "=", 
   RowBox[{"Flatten", "@", 
    RowBox[{"ChernToCh", "[", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"SpectralFlow", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"CollInitial", "[", 
           RowBox[{"[", "3", "]"}], "]"}], "/.", "repCh"}], ",", " ", 
