          RowBox[{"(", 
           RowBox[{"k", "-", "m"}], ")"}], "/", "2"}], ",", " ", 
         RowBox[{
          RowBox[{
           RowBox[{"-", "1"}], "/", "2"}], "-", "k", "+", "m"}]}], "}"}], ",",
        " ", 
       RowBox[{"{", 
        RowBox[{"k", ",", 
         RowBox[{"-", "5"}], ",", "5"}], "}"}]}], "]"}], "]"}]}]}], 
