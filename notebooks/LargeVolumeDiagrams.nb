       RowBox[{"gam", "/.", "gamToString"}], ",", " ", 
       RowBox[{"pos", "[", "t", "]"}], ",", " ", 
       RowBox[{
        RowBox[{"-", "s"}], "*", "1.5", "*", "normal"}], ",", " ", 
