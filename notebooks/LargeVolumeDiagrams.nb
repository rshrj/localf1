Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"m", "=", 
      RowBox[{"1", "/", "10"}]}], ",", " ", 
     RowBox[{"psi", "=", "0"}], ",", " ", 
     RowBox[{"coll", "=", 
      RowBox[{"CollInitial", "[", 
       RowBox[{"[", "1", "]"}], "]"}]}], ",", " ", 
     RowBox[{"L", "=", "5"}], ",", " ", 
     RowBox[{"xmin", "=", 
      RowBox[{"-", "1"}]}], ",", " ", 
     RowBox[{"xmax", "=", "2"}]}], "}"}], ",", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"charges", "=", 
     RowBox[{"Flatten", "[", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"s", " ", "gam"}], "/.", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Ch", "[", 
            RowBox[{"p_", ",", "q_"}], "]"}], ":>", 
           RowBox[{"Ch", "[", 
            RowBox[{
             RowBox[{"p", "+", 
              RowBox[{"3", "k"}]}], ",", 
             RowBox[{"q", "+", 
              RowBox[{"2", "k"}]}]}], "]"}]}], "}"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"gam", ",", " ", "coll"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"k", ",", 
          RowBox[{"-", "L"}], ",", "L"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"s", ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", "1"}], ",", "1"}], "}"}]}], "}"}]}], "]"}], "]"}]}], 
    ";", "\[IndentingNewLine]", 
    RowBox[{"charges", "=", 
     RowBox[{"Join", "[", 
      RowBox[{"charges", ",", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"GV", "[", 
          RowBox[{"0", ",", "1", ",", 
           RowBox[{
            RowBox[{
             RowBox[{"-", "1"}], "/", "2"}], "-", "k"}]}], "]"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"k", ",", 
           RowBox[{"-", "L"}], ",", "L"}], "}"}]}], "]"}]}], "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"charges", "=", 
     RowBox[{"Select", "[", 
      RowBox[{"charges", ",", " ", 
       RowBox[{
        RowBox[{"xmin", "<=", 
         RowBox[{"Rays", "[", 
          RowBox[{
           RowBox[{"#", "/.", "repCh"}], ",", "0", ",", "psi", ",", "m"}], 
          "]"}], "<=", "xmax"}], "&"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"rays", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Tooltip", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Rays", "[", 
            RowBox[{
             RowBox[{"g", "/.", "repCh"}], ",", " ", "t", ",", "psi", ",", 
             "m"}], "]"}], ",", " ", "t"}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"g", ",", " ", 
           RowBox[{"Last", "[", 
            RowBox[{"Initials", "[", 
             RowBox[{
              RowBox[{"g", "/.", "repCh"}], ",", "m", ",", " ", 
              RowBox[{"\"\<Verbose\>\"", "->", "False"}]}], "]"}], "]"}]}], 
          "}"}]}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"g", ",", " ", "charges"}], "}"}]}], "]"}]}], ";", 
    "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{"othercharges", "=", 
     RowBox[{"Flatten", "[", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"s", " ", 
         RowBox[{"Ch", "[", 
          RowBox[{"p", ",", "q"}], "]"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"p", ",", 
          RowBox[{"-", "L"}], ",", "L"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"q", ",", 
          RowBox[{"-", "L"}], ",", "L"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"s", ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", "1"}], ",", "1"}], "}"}]}], "}"}]}], "]"}], "]"}]}], 
    ";", "\[IndentingNewLine]", 
    RowBox[{"othercharges", "=", 
     RowBox[{"Select", "[", 
      RowBox[{"othercharges", ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"xmin", "<=", 
          RowBox[{"Rays", "[", 
           RowBox[{
            RowBox[{"#", "/.", "repCh"}], ",", "0", ",", "psi", ",", "m"}], 
           "]"}], "<=", "xmax"}], "&&", 
         RowBox[{"!", 
          RowBox[{"MemberQ", "[", 
           RowBox[{"charges", ",", "#"}], "]"}]}]}], "&"}]}], "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"othercharges", "=", 
     RowBox[{"Join", "[", 
      RowBox[{"othercharges", ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"GV", "[", 
          RowBox[{"1", ",", "0", ",", "0"}], "]"}], ",", " ", 
         RowBox[{"GV", "[", 
          RowBox[{"1", ",", "0", ",", "1"}], "]"}], ",", " ", 
         RowBox[{"GV", "[", 
          RowBox[{"1", ",", "0", ",", "2"}], "]"}]}], "}"}]}], "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"otherrays", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Tooltip", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Rays", "[", 
            RowBox[{
             RowBox[{"g", "/.", "repCh"}], ",", " ", "t", ",", "psi", ",", 
             "m"}], "]"}], ",", " ", "t"}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"g", ",", " ", 
           RowBox[{"Last", "[", 
            RowBox[{"Initials", "[", 
             RowBox[{
              RowBox[{"g", "/.", "repCh"}], ",", "m", ",", " ", 
              RowBox[{"\"\<Verbose\>\"", "->", "False"}]}], "]"}], "]"}]}], 
          "}"}]}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"g", ",", " ", "othercharges"}], "}"}]}], "]"}]}], ";", 
    "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{"dBr", "=", 
     RowBox[{"MakeDomain", "[", 
      RowBox[{
       RowBox[{"AsBr", "[", "m", "]"}], ",", "m"}], "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"dAI", "=", 
     RowBox[{"MakeDomain", "[", 
      RowBox[{
       RowBox[{"AsAI", "[", "m", "]"}], ",", "m"}], "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"dAII", "=", 
     RowBox[{"MakeDomain", "[", 
      RowBox[{
