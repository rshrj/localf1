             RowBox[{"g", "/.", "repCh"}], ",", " ", "t", ",", "psi", ",", 
             "m"}], "]"}], ",", " ", "t"}], "}"}], ",", " ", "g"}], "]"}], ",",
        " ", 
       RowBox[{"{", 
        RowBox[{"g", ",", " ", "charges"}], "}"}]}], "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"captions", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"GamCaption", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"RandomReal", "[", 
          RowBox[{"{", 
           RowBox[{".2", ",", ".4"}], "}"}], "]"}], ",", "psi", ",", "m"}], 
        "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"g", ",", " ", "charges"}], "}"}]}], "]"}]}], ";", 
    "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{"(*", " ", 
     RowBox[{"compute", " ", "quiver", " ", "domains"}], " ", "*)"}], 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"CollDom", "[", 
      RowBox[{"Coll_", ",", " ", "Color_"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", "possibleSpecParams", "}"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"possibleSpecParams", " ", "=", " ", 
         RowBox[{"Echo", "@", 
          RowBox[{"ListSpecFlows", "[", 
           RowBox[{
           "Coll", ",", " ", "psi", ",", " ", "m", ",", " ", "12", ",", " ", 
            "xmin", ",", " ", "xmax", ",", " ", "tmax"}], "]"}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"QuiverDomain", "[", 
           RowBox[{
            RowBox[{"SpectralFlow", "[", 
             RowBox[{"Coll", ",", " ", "spec"}], "]"}], ",", "psi", ",", "m", 
            ",", 
            RowBox[{"PlotStyle", "->", "Color"}], ",", 
            RowBox[{"PlotRange", "->", 
             RowBox[{"{", 
