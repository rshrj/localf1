Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", 
   RowBox[{"AsBr", ",", "AsAI", ",", "AsAII"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"AsBr", "[", "m_", "]"}], ":=", 
   RowBox[{"<|", 
    RowBox[{
     RowBox[{"\"\<Coll\>\"", "->", "CollBridgeland"}], ",", " ", 
     RowBox[{"\"\<SpectralFlows\>\"", "->", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"mf", ",", " ", 
          RowBox[{"Ceiling", "[", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{"2", "mf"}], "+", 
              RowBox[{"3", "m"}], "-", "1"}], ")"}], "/", "3"}], "]"}]}], 
         "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"mf", ",", "0", ",", "4"}], "}"}]}], "]"}]}], ",", " ", 
     RowBox[{"\"\<Color\>\"", "->", "LightBlue"}], ",", " ", 
     RowBox[{"\"\<Label\>\"", "->", "\"\<Br\>\""}]}], "|>"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"AsAI", "[", "m_", "]"}], ":=", 
   RowBox[{"<|", 
    RowBox[{
     RowBox[{"\"\<Coll\>\"", "->", "CollArcaraI"}], ",", " ", 
     RowBox[{"\"\<SpectralFlows\>\"", "->", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"mf", ",", " ", 
          RowBox[{"Ceiling", "[", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{"2", "mf"}], "+", 
              RowBox[{"3", "m"}], "-", "3"}], ")"}], "/", "3"}], "]"}]}], 
         "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"mf", ",", "1", ",", "5"}], "}"}]}], "]"}]}], ",", " ", 
     RowBox[{"\"\<Color\>\"", "->", "LightGreen"}], ",", " ", 
     RowBox[{"\"\<Label\>\"", "->", "\"\<ArI\>\""}]}], "|>"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"AsAII", "[", "m_", "]"}], ":=", 
   RowBox[{"<|", 
    RowBox[{
     RowBox[{"\"\<Coll\>\"", "->", "CollArcaraII"}], ",", " ", 
     RowBox[{"\"\<SpectralFlows\>\"", "->", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"mf", ",", " ", 
          RowBox[{"Ceiling", "[", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{"2", "mf"}], "+", 
              RowBox[{"3", "m"}], "-", "1"}], ")"}], "/", "3"}], "]"}]}], 
         "}"}], ",", " ", 
        RowBox[{"{", 
