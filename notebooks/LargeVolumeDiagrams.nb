 RowBox[{
  RowBox[{"GamCaption", "[", 
   RowBox[{"gam_", ",", "t_", ",", "psi_", ",", "m_"}], "]"}], " ", ":=", " ", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "s", ",", " ", "tt", ",", "pos", ",", " ", "dir", ",", " ", "normal"}], 
     "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"s", " ", "=", " ", 
      RowBox[{"Sign", "[", 
       RowBox[{"gam", "[", 
        RowBox[{"[", "1", "]"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"pos", "[", "tt_", "]"}], "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Rays", "[", 
         RowBox[{
          RowBox[{"gam", "/.", "repCh"}], ",", "tt", ",", "psi", ",", " ", 
          "m"}], "]"}], ",", "tt"}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"dir", " ", "=", " ", 
      RowBox[{"Normalize", "[", 
       RowBox[{
        RowBox[{"D", "[", 
         RowBox[{
          RowBox[{"pos", "[", "tt", "]"}], ",", "tt"}], "]"}], "/.", 
        RowBox[{"{", 
         RowBox[{"tt", "->", "t"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"normal", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"dir", "[", 
         RowBox[{"[", "2", "]"}], "]"}], ",", 
        RowBox[{"-", 
         RowBox[{"dir", "[", 
          RowBox[{"[", "1", "]"}], "]"}]}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
