     RowBox[{"{", 
      RowBox[{"spec", ",", " ", 
       RowBox[{"AsColl", "[", "\"\<SpectralFlows\>\"", "]"}]}], "}"}]}], 
    "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.9785124054642563`*^9, 3.978512492187804*^9}, {
