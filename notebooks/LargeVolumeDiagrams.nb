         RowBox[{"Simplify", "[", "#", "]"}], "]"}]}], "}"}], "]"}], "&"}], "@", 
    RowBox[{"Flatten", "[", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"m", "+", "k"}], ")"}], "/", "4"}], ",", " ", 
