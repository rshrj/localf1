Cell[CellGroupData[{

Cell["0 < m < 1/3", "Section",
 CellChangeTimes->{{3.9765972836699457`*^9, 
  3.9765972878529177`*^9}},ExpressionUUID->"4fa41679-d97c-49f2-a368-\
d1bc42fb485c"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"charges", "=", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"L", "=", "5"}], "}"}], ",", 
     RowBox[{"Flatten", "[", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"s", " ", 
         RowBox[{"Ch", "[", 
          RowBox[{"p", ",", "q"}], "]"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"p", ",", 
          RowBox[{"-", "L"}], ",", "L"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"q", ",", 
          RowBox[{"-", "L"}], ",", "L"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"s", ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", "1"}], ",", "1"}], "}"}]}], "}"}]}], "]"}], "]"}]}], 
    "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"m", "=", 
      RowBox[{"1", "/", "10"}]}], ",", " ", 
     RowBox[{"psi", "=", "0"}], ",", " ", 
     RowBox[{"xmin", "=", 
      RowBox[{"-", "0.2"}]}], ",", " ", 
     RowBox[{"xmax", "=", "1.2"}], ",", " ", 
     RowBox[{"tmax", "=", "0.5"}]}], "}"}], ",", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"charges", "=", 
     RowBox[{"Select", "[", 
      RowBox[{"charges", ",", " ", 
       RowBox[{
        RowBox[{"xmin", "<=", 
         RowBox[{"Rays", "[", 
          RowBox[{
           RowBox[{"#", "/.", "repCh"}], ",", "0", ",", "psi", ",", "m"}], 
          "]"}], "<=", "xmax"}], "&"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"(*", " ", 
     RowBox[{"add", " ", "Rank", " ", "0", " ", "sheaf"}], " ", "*)"}], 
    "\[IndentingNewLine]", 
    RowBox[{"AppendTo", "[", 
     RowBox[{"charges", ",", 
      RowBox[{"GV", "[", 
       RowBox[{"0", ",", 
        RowBox[{"-", "1"}], ",", 
        RowBox[{
         RowBox[{"-", "1"}], "/", "2"}]}], "]"}]}], "]"}], ";", 
    "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{"(*", " ", 
     RowBox[{"compute", " ", "rays", " ", "and", " ", "captions"}], " ", 
     "*)"}], "\[IndentingNewLine]", 
    RowBox[{"rays", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Tooltip", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Rays", "[", 
            RowBox[{
             RowBox[{"g", "/.", "repCh"}], ",", " ", "t", ",", "psi", ",", 
             "m"}], "]"}], ",", " ", "t"}], "}"}], ",", " ", "g"}], "]"}], ",",
        " ", 
       RowBox[{"{", 
        RowBox[{"g", ",", " ", "charges"}], "}"}]}], "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"captions", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"GamCaption", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"RandomReal", "[", 
          RowBox[{"{", 
           RowBox[{".2", ",", ".4"}], "}"}], "]"}], ",", "psi", ",", "m"}], 
        "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"g", ",", " ", "charges"}], "}"}]}], "]"}]}], ";", 
    "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{"(*", " ", 
     RowBox[{"compute", " ", "quiver", " ", "domains"}], " ", "*)"}], 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"CollDom", "[", 
      RowBox[{"Coll_", ",", " ", "Color_"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", "possibleSpecParams", "}"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"possibleSpecParams", " ", "=", " ", 
         RowBox[{"Select", "[", 
          RowBox[{
           RowBox[{"With", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"L", "=", "6"}], "}"}], ",", 
             RowBox[{"Flatten", "[", 
              RowBox[{
               RowBox[{"Table", "[", 
                RowBox[{
                 RowBox[{"{", 
                  RowBox[{"mF", ",", "mB"}], "}"}], ",", 
                 RowBox[{"{", 
                  RowBox[{"mF", ",", 
                   RowBox[{"-", "L"}], ",", "L"}], "}"}], ",", 
                 RowBox[{"{", 
                  RowBox[{"mB", ",", 
                   RowBox[{"-", "L"}], ",", "L"}], "}"}]}], "]"}], ",", "1"}],
               "]"}]}], "]"}], ",", " ", 
           RowBox[{
            RowBox[{
             RowBox[{"With", "[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"z", "=", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"ZLV", "[", 
                    RowBox[{"#", ",", 
                    RowBox[{"{", 
                    RowBox[{"s", ",", "t"}], "}"}], ",", "m"}], "]"}], "&"}], 
                  "/@", 
                  RowBox[{"SpectralFlow", "[", 
                   RowBox[{"Coll", ",", " ", "#"}], "]"}]}]}], "}"}], ",", 
               " ", 
               RowBox[{"FullSimplify", "@", 
                RowBox[{"ComplexExpand", "[", 
                 RowBox[{
                  RowBox[{"AllTrue", "[", 
                   RowBox[{"z", ",", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"Re", "[", 
                    RowBox[{
                    RowBox[{"Exp", "[", 
                    RowBox[{
                    RowBox[{"-", "I"}], " ", "psi"}], "]"}], "#"}], "]"}], "<",
                     "0"}], "&"}]}], "]"}], "&&", 
                  RowBox[{"(", 
                   RowBox[{
                    RowBox[{"xmin", "<=", "s", "<=", "xmax"}], "&&", 
                    RowBox[{"0", "<=", "t", "<=", "tmax"}]}], ")"}]}], 
                 "]"}]}]}], "]"}], "=!=", "False"}], "&"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"QuiverDomain", "[", 
           RowBox[{
            RowBox[{"SpectralFlow", "[", 
             RowBox[{"Coll", ",", " ", "spec"}], "]"}], ",", "psi", ",", "m", 
            ",", 
            RowBox[{"PlotStyle", "->", "Color"}], ",", 
            RowBox[{"PlotRange", "->", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"xmin", ",", "xmax"}], "}"}], ",", 
               RowBox[{"{", 
                RowBox[{"0", ",", "tmax"}], "}"}]}], "}"}]}], ",", " ", 
            RowBox[{"PlotPoints", "->", "20"}]}], "]"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"spec", ",", "possibleSpecParams"}], "}"}]}], "]"}]}]}], 
      "\[IndentingNewLine]", "]"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"PrintTemporary", "[", "\"\<Computing domainI\>\"", "]"}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"domainI", " ", "=", " ", 
     RowBox[{"CollDom", "[", 
      RowBox[{"CollArcaraI", ",", " ", "LightGreen"}], "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"PrintTemporary", "[", "\"\<Computing domainII\>\"", "]"}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"domainII", " ", "=", " ", 
     RowBox[{"CollDom", "[", 
      RowBox[{"CollArcaraII", ",", " ", "LightRed"}], "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"PrintTemporary", "[", "\"\<Computing domainBr\>\"", "]"}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"domainBr", " ", "=", " ", 
     RowBox[{"CollDom", "[", 
      RowBox[{"CollBridgeland", ",", " ", "LightBlue"}], "]"}]}], ";", 
    "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{"Show", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"ParametricPlot", "[", 
       RowBox[{"rays", ",", " ", 
        RowBox[{"{", 
         RowBox[{"t", ",", "0", ",", "0.5"}], "}"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"PlotStyle", "->", 
         TemplateBox[<|"color" -> RGBColor[0.28, 0.28, 0.28]|>,
          "RGBColorSwatchTemplate"]}], ",", "\[IndentingNewLine]", 
        RowBox[{"PlotRange", "->", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"-", "0.2"}], ",", "1.2"}], "}"}], ",", "Automatic"}], 
          "}"}]}], ",", "\[IndentingNewLine]", 
        RowBox[{"Frame", "->", "False"}], ",", "\[IndentingNewLine]", 
        RowBox[{"Axes", "->", "False"}], ",", "\[IndentingNewLine]", 
        RowBox[{"GridLines", "->", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"-", "1"}], ",", "0", ",", "1"}], "}"}], ",", " ", 
           RowBox[{"{", "0", "}"}]}], "}"}]}], ",", "\[IndentingNewLine]", 
        RowBox[{"GridLinesStyle", "->", 
         RowBox[{"Directive", "[", 
          RowBox[{"Thickness", "[", ".001", "]"}], "]"}]}]}], 
       "\[IndentingNewLine]", "]"}], ",", "\[IndentingNewLine]", "domainI", ",",
       "\[IndentingNewLine]", "domainII", ",", "\[IndentingNewLine]", 
      "domainBr"}], "\[IndentingNewLine]", "]"}]}]}], "\[IndentingNewLine]", 
  "]"}]}], "Input",
