Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"MakeDomain", "[", 
    RowBox[{"AsColl_", ",", " ", "m_"}], "]"}], ":=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"QDomain", "[", 
      RowBox[{
       RowBox[{"SpectralFlow", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"AsColl", "[", "\"\<Coll\>\"", "]"}], "/.", "repCh"}], ",", 
         " ", "spec"}], "]"}], ",", " ", "m", ",", 
       RowBox[{
        RowBox[{"AsColl", "[", "\"\<Label\>\"", "]"}], 
        "<>", "\"\<\!\(\*StyleBox[\"\[CircleTimes]\", \
\"OperatorCharacter\"]\)\>\"", "<>", 
        RowBox[{"ToString", "[", "spec", "]"}]}], ",", " ", 
       RowBox[{"PlotStyle", "->", 
        RowBox[{"Directive", "[", 
         RowBox[{
          RowBox[{"AsColl", "[", "\"\<Color\>\"", "]"}], ",", " ", 
          RowBox[{"Opacity", "[", ".7", "]"}]}], "]"}]}], ",", " ", 
       RowBox[{"BoundaryStyle", "->", "Transparent"}], ",", " ", 
