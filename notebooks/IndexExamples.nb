Cell[CellGroupData[{

Cell["Examples at m = 1/10", "Section",
 CellChangeTimes->{{3.977550932648355*^9, 
  3.977550937213533*^9}},ExpressionUUID->"24a3688a-4e4d-4fd8-9e49-\
a9899bc50823"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"mu", "=", 
      RowBox[{"1", "/", "10"}]}], ",", " ", 
     RowBox[{"L", "=", "4"}], ",", 
     RowBox[{"len", "=", "20"}]}], "}"}], ",", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"InitialRaysp", "=", 
     RowBox[{"InitialRaysFromColl", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"CollInitial", "[", 
         RowBox[{"[", "1", "]"}], "]"}], "/.", "repCh"}], ",", " ", 
       RowBox[{"-", "2"}], ",", "2", ",", "mu"}], "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"ListRaysp", "=", 
     RowBox[{"ConstructLVDiagramOpt", "[", 
      RowBox[{"13", ",", "4", ",", "mu", ",", "InitialRaysp"}], "]"}]}], ";", 
    "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{"Show", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Plot", "[", 
       RowBox[{
        RowBox[{"XYParabolaY", "[", 
         RowBox[{"x", ",", "mu", ",", "0", ",", "0"}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"x", ",", 
          RowBox[{"-", "2"}], ",", "2"}], "}"}], ",", "\[IndentingNewLine]", 
        RowBox[{"PlotRange", "->", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"-", "1.5"}], ",", "1.5"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"-", "7"}], ",", "2"}], "}"}]}], "}"}]}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"PlotStyle", "->", 
         RowBox[{"Directive", "[", 
          RowBox[{"Dashed", ",", "Thick", ",", "Black"}], "]"}]}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"GridLines", "->", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"-", "0.2"}], ",", "1.2"}], "}"}], ",", "None"}], 
          "}"}]}]}], "\[IndentingNewLine]", "]"}], ",", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"Graphics", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Opacity", "[", ".25", "]"}], ",", 
           RowBox[{
            RowBox[{
             RowBox[{"ConstructDomain", "[", 
              RowBox[{"#", ",", " ", "mu", ",", "L"}], "]"}], "&"}], "/@", 
            "CollPlotData"}]}], "}"}], "]"}], ","}], "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"Graphics", "[", 
       RowBox[{"{", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"Tooltip", "[", 
            RowBox[{
             RowBox[{"XYRaySegment", "[", 
              RowBox[{"#", ",", "mu", ",", "len", ",", "RayStyleMap"}], "]"}],
              ",", " ", 
             RowBox[{"#", "[", 
              RowBox[{"[", "1", "]"}], "]"}]}], "]"}], "&"}], "/@", 
          "ListRaysp"}], ",", "    ", 
         RowBox[{"(*", "rays", "*)"}], "\[IndentingNewLine]", 
         RowBox[{"PointSize", "[", ".004", "]"}], ",", "Red", ",", 
         "\[IndentingNewLine]", 
         RowBox[{"Point", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"#", "[", 
             RowBox[{"[", "2", "]"}], "]"}], "&"}], "/@", "InitialRaysp"}], 
          "]"}]}], "                   ", 
        RowBox[{"(*", 
         RowBox[{"initial", " ", "positions"}], "*)"}], "\[IndentingNewLine]",
         "}"}], "]"}]}], "\[IndentingNewLine]", "]"}]}]}], 
  "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{{3.9774709986759443`*^9, 3.9774710393155518`*^9}, {
