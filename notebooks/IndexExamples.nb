       RowBox[{
        RowBox[{"ToHC", "[", "gam", "]"}], ",", "gam", ",", " ", 
        RowBox[{"Column", "[", 
         RowBox[{"ChernToCh", "[", "temp", "]"}], "]"}], ",", " ", 
        RowBox[{"Column", "[", 
         RowBox[{
          RowBox[{"ChernToCh", "[", "temp", "]"}], "/.", 
          RowBox[{"{", 
