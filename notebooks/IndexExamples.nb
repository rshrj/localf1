     RowBox[{"FileNameJoin", "[", 
      RowBox[{"{", 
       RowBox[{"repoRoot", ",", "\"\<mma\>\"", ",", "\"\<extern\>\""}], "}"}],
       "]"}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"!", 
       RowBox[{"MemberQ", "[", 
        RowBox[{"$Path", ",", "repoAppDir"}], "]"}]}], ",", 
      RowBox[{
       RowBox[{"AppendTo", "[", 
        RowBox[{"$Path", ",", "repoAppDir"}], "]"}], ";"}]}], "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"!", 
       RowBox[{"MemberQ", "[", 
        RowBox[{"$Path", ",", "repoExternDir"}], "]"}]}], ",", 
