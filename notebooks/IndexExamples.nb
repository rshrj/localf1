Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Compute", " ", "the", " ", "repo", " ", "root", " ", "from", " ", "the", " ",
     "notebook", " ", "location"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"repoRoot", "=", 
     RowBox[{"ParentDirectory", "@", 
      RowBox[{"NotebookDirectory", "[", "]"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"repoAppDir", "=", 
     RowBox[{"FileNameJoin", "[", 
      RowBox[{"{", 
       RowBox[{"repoRoot", ",", "\"\<mma\>\""}], "}"}], "]"}]}], ";"}], "\n", 
   
   RowBox[{
    RowBox[{"repoExternDir", "=", 
     RowBox[{"FileNameJoin", "[", 
      RowBox[{"{", 
       RowBox[{"repoRoot", ",", "\"\<mma\>\"", ",", "\"\<extern\>\""}], "}"}],
       "]"}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"!", 
       RowBox[{"MemberQ", "[", 
        RowBox[{"$Path", ",", "repoAppDir"}], "]"}]}], ",", 
      RowBox[{
       RowBox[{"AppendTo", "[", 
        RowBox[{"$Path", ",", "repoAppDir"}], "]"}], ";"}]}], "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"!", 
       RowBox[{"MemberQ", "[", 
        RowBox[{"$Path", ",", "repoExternDir"}], "]"}]}], ",", 
      RowBox[{
       RowBox[{"AppendTo", "[", 
        RowBox[{"$Path", ",", "repoExternDir"}], "]"}], ";"}]}], "]"}], ";"}],
    "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"ClearAll", "[", "\"\<LocalF1`*\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"<<", "LocalF1`"}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
