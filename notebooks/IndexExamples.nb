2af425c61d8d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"mu", "=", 
      RowBox[{
       RowBox[{"-", "1"}], "/", "10"}]}], ",", " ", 
     RowBox[{"L", "=", "4"}], ",", 
     RowBox[{"len", "=", "20"}]}], "}"}], ",", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"InitialRays", "=", 
     RowBox[{"InitialRaysFromColl", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"CollInitial", "[", 
         RowBox[{"[", "3", "]"}], "]"}], "/.", "repCh"}], ",", " ", 
       RowBox[{"-", "2"}], ",", "1", ",", "mu"}], "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"ListRays", "=", 
     RowBox[{"ConstructLVDiagramOpt", "[", 
      RowBox[{"13", ",", "4", ",", "mu", ",", "InitialRays"}], "]"}]}], ";", 
    "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{"Show", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Plot", "[", 
       RowBox[{
        RowBox[{"XYParabolaY", "[", 
         RowBox[{"x", ",", "mu", ",", "0", ",", "0"}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"x", ",", 
          RowBox[{"-", "2"}], ",", "2"}], "}"}], ",", "\[IndentingNewLine]", 
        RowBox[{"PlotRange", "->", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"-", "1"}], ",", "1.2"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"-", "2"}], ",", "1"}], "}"}]}], "}"}]}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"PlotStyle", "->", 
         RowBox[{"Directive", "[", 
          RowBox[{"Dashed", ",", "Thick", ",", "Black"}], "]"}]}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"GridLines", "->", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"-", "0.2"}], ",", "1.2"}], "}"}], ",", "None"}], 
          "}"}]}]}], "\[IndentingNewLine]", "]"}], ",", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"Graphics", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Opacity", "[", ".25", "]"}], ",", 
           RowBox[{
            RowBox[{
             RowBox[{"ConstructDomain", "[", 
              RowBox[{"#", ",", " ", "mu", ",", "L"}], "]"}], "&"}], "/@", 
            "CollPlotData"}]}], "}"}], "]"}], ","}], "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"Graphics", "[", 
       RowBox[{"{", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"Tooltip", "[", 
            RowBox[{
             RowBox[{"XYRaySegment", "[", 
              RowBox[{"#", ",", "mu", ",", "len", ",", "RayStyleMap"}], "]"}],
              ",", " ", 
             RowBox[{"#", "[", 
              RowBox[{"[", "1", "]"}], "]"}]}], "]"}], "&"}], "/@", 
          "ListRays"}], ",", "    ", 
         RowBox[{"(*", "rays", "*)"}], "\[IndentingNewLine]", 
         RowBox[{"PointSize", "[", ".004", "]"}], ",", "Red", ",", 
         "\[IndentingNewLine]", 
         RowBox[{"Point", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"#", "[", 
             RowBox[{"[", "2", "]"}], "]"}], "&"}], "/@", "InitialRays"}], 
          "]"}]}], "                   ", 
        RowBox[{"(*", 
         RowBox[{"initial", " ", "positions"}], "*)"}], "\[IndentingNewLine]",
         "}"}], "]"}]}], "\[IndentingNewLine]", "]"}]}]}], 
  "\[IndentingNewLine]", "]"}]], "Input",
