  RowBox[{
   RowBox[{"ROCFrob1", "[", 
    RowBox[{"t_", "?", "NumericQ"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"v", ",", "rootsV", ",", "rootsR", ",", "rho"}], "}"}], ",", 
     RowBox[{
      RowBox[{"rootsV", "=", 
