        "\[IndentingNewLine]", 
        RowBox[{"LinearSolve", "[", 
         RowBox[{"SystMat", ",", 
          RowBox[{"mon", ".", "SystMat"}]}], "]"}]}], ",", 
       RowBox[{"msg", "<>", "\"\< \>\"", "<>", 
        RowBox[{"ToString", "[", 
         RowBox[{"Floor", "[", 
          RowBox[{"100", " ", "tt"}], "]"}], "]"}], "<>", "\"\<%.\>\""}]}], 
      "]"}]}], "]"}]}], ";"}]}], "Input",
