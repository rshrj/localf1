     RowBox[{"Nn_", ":", "512"}], ",", 
     RowBox[{"Nr_", ":", "5"}], ",", 
     RowBox[{"OptionsPattern", "[", "]"}]}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "sol", ",", "Psi", ",", "mon", ",", "SystMat", ",", "msg", ",", 
       RowBox[{"tt", "=", "0"}]}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{"Monitor", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"msg", "=", "\"\<Integrating the connection...\>\""}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"sol", "=", 
         RowBox[{"NDSolve", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"Psi", "'"}], "[", "t", "]"}], "==", 
              RowBox[{
               RowBox[{
                RowBox[{"upath", "'"}], "[", "t", "]"}], "*", 
               RowBox[{
                RowBox[{"PicardFuchsA2", "[", 
                 RowBox[{"el", ",", 
                  RowBox[{"upath", "[", "t", "]"}]}], "]"}], ".", 
                RowBox[{"Psi", "[", "t", "]"}]}]}]}], ",", 
             RowBox[{
              RowBox[{"Psi", "[", "0", "]"}], "==", 
              RowBox[{"IdentityMatrix", "[", "3", "]"}]}]}], "}"}], ",", 
           "Psi", ",", 
           RowBox[{"{", 
            RowBox[{"t", ",", "0", ",", "1"}], "}"}], ",", 
           RowBox[{"WorkingPrecision", "->", 
            RowBox[{"OptionValue", "[", "WorkingPrecision", "]"}]}], ",", 
           RowBox[{"MaxSteps", "->", 
            RowBox[{"10", "^", "7"}]}], ",", 
           RowBox[{"StepMonitor", ":>", 
            RowBox[{"(", 
             RowBox[{"tt", "=", "t"}], ")"}]}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"mon", "=", 
         RowBox[{
          RowBox[{"Psi", "[", "1", "]"}], "/.", " ", 
          RowBox[{"First", "[", "sol", "]"}]}]}], ";", "\[IndentingNewLine]", 
        
        RowBox[{"msg", "=", "\"\<Solving for the system matrix...\>\""}], ";",
         "\[IndentingNewLine]", 
        RowBox[{"SystMat", "=", 
         RowBox[{"SystemMatrix2", "[", 
          RowBox[{
           RowBox[{"F1Series2", "[", 
            RowBox[{"el", ",", 
             RowBox[{"upath", "[", "0", "]"}], ",", "Nn", ",", "Nr"}], "]"}], 
           ",", "el", ",", 
