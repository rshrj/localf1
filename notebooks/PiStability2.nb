      ",", "\"\< seconds\>\""}], "]"}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Verify", " ", "they", " ", "produced", " ", "the", " ", "exact", " ", 
     "same", " ", "result"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Results match? \>\"", ",", 
      RowBox[{"res1", "===", "res2"}]}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Speedup factor: \>\"", ",", 
      RowBox[{"Round", "[", 
