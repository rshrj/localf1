Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"with", " ", "progress", " ", "indication"}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"ClearAll", "[", "ComputeCFromUAndO1Fast", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"ComputeCFromUAndO1Fast", "[", 
     RowBox[{"UList_List", ",", "o1List_List", ",", 
      RowBox[{"Nmax1_", ":", "0"}]}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "nmax", ",", "maxPow", ",", "uPoly", ",", "uPowers", ",", "o1y", ",", 
        "o1sq", ",", "o1cube", ",", "prefCoeffs", ",", "pref"}], "}"}], ",", 
      RowBox[{
       RowBox[{"nmax", "=", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"Nmax1", ">", "0"}], ",", 
          RowBox[{"Min", "[", 
           RowBox[{"Nmax1", ",", 
            RowBox[{"Length", "[", "UList", "]"}]}], "]"}], ",", 
          RowBox[{"Length", "[", "UList", "]"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"nmax", "<=", "0"}], ",", 
         RowBox[{"Return", "[", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"o1List", "[", 
             RowBox[{"[", "1", "]"}], "]"}], "^", "3"}], "}"}], "]"}]}], 
        "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"1.", " ", 
         RowBox[{"Setup", ":", 
          RowBox[{
          "Ensure", " ", "we", " ", "compute", " ", "at", " ", "least", " ", 
           "up", " ", "to", " ", 
           RowBox[{"u", "^", "3"}], " ", "for", " ", "the", " ", 
           "prefactor"}]}]}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{"maxPow", "=", 
        RowBox[{"Max", "[", 
         RowBox[{"3", ",", 
          RowBox[{
           RowBox[{"Length", "[", "o1List", "]"}], "-", "1"}]}], "]"}]}], ";",
        "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{
         "Initialize", " ", "the", " ", "uPowers", " ", "matrix", " ", "to", " ",
           "hold", " ", 
          RowBox[{"u", "^", "0"}]}], ",", 
         RowBox[{"u", "^", "1"}], ",", "...", ",", 
         RowBox[{"u", "^", "maxPow"}]}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{"uPowers", "=", 
        RowBox[{"ConstantArray", "[", 
         RowBox[{"0", ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"maxPow", "+", "1"}], ",", 
            RowBox[{"nmax", "+", "1"}]}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"u", "^", "0"}], " ", "is", " ", "simply", " ", "1", " ", 
         "followed", " ", "by", " ", "zeros"}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"uPowers", "[", 
         RowBox[{"[", 
          RowBox[{"1", ",", "1"}], "]"}], "]"}], "=", "1"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"u", "^", "1"}], " ", "is", " ", "UList", " ", "shifted", " ",
          "to", " ", "start", " ", "with", " ", "the", " ", 
         RowBox[{"y", "^", "0"}], " ", "coefficient", " ", 
         RowBox[{"(", 
          RowBox[{"which", " ", "is", " ", "0"}], ")"}]}], "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"uPoly", "=", 
        RowBox[{"PadRight", "[", 
         RowBox[{
          RowBox[{"Prepend", "[", 
           RowBox[{
            RowBox[{"Take", "[", 
             RowBox[{"UList", ",", "nmax"}], "]"}], ",", "0"}], "]"}], ",", 
          RowBox[{"nmax", "+", "1"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"uPowers", "[", 
         RowBox[{"[", "2", "]"}], "]"}], "=", "uPoly"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
        "2.", " ", "Build", " ", "Powers", " ", "with", " ", "Progress", " ", 
         "Indicator"}], "*)"}], 
       RowBox[{"Monitor", "[", 
        RowBox[{
         RowBox[{"For", "[", 
          RowBox[{
           RowBox[{"m", "=", "2"}], ",", 
           RowBox[{"m", "<=", "maxPow"}], ",", 
           RowBox[{"m", "++"}], ",", 
           RowBox[{
            RowBox[{
             RowBox[{"uPowers", "[", 
              RowBox[{"[", 
               RowBox[{"m", "+", "1"}], "]"}], "]"}], "=", 
             RowBox[{"PadRight", "[", 
              RowBox[{
               RowBox[{"convTruncFast", "[", 
                RowBox[{
                 RowBox[{"uPowers", "[", 
                  RowBox[{"[", "m", "]"}], "]"}], ",", "uPoly", ",", "nmax"}],
                 "]"}], ",", 
               RowBox[{"nmax", "+", "1"}]}], "]"}]}], ";"}]}], "]"}], ",", 
         RowBox[{"(*", 
          RowBox[{
          "This", " ", "UI", " ", "block", " ", "updates", " ", "dynamically",
            " ", 
           RowBox[{"as", "'"}], 
           RowBox[{"m", "'"}], " ", "changes"}], "*)"}], 
         RowBox[{"Panel", "@", 
          RowBox[{"Column", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"Text", "[", 
               RowBox[{"Style", "[", 
                
                RowBox[{"\"\<Computing Powers of u(y)...\>\"", ",", "12", ",",
                  "Bold", ",", 
                 RowBox[{"Darker", "[", "Blue", "]"}]}], "]"}], "]"}], ",", 
              RowBox[{"ProgressIndicator", "[", 
               RowBox[{"m", ",", 
                RowBox[{"{", 
                 RowBox[{"2", ",", "maxPow"}], "}"}]}], "]"}], ",", 
              RowBox[{"Text", "[", 
               RowBox[{"Style", "[", 
                RowBox[{
                 RowBox[{"Row", "[", 
                  RowBox[{"{", 
                   
                   RowBox[{"\"\<Iteration \>\"", ",", "m", ",", "\"\< of \>\"",
                     ",", "maxPow"}], "}"}], "]"}], ",", "10", ",", "Gray"}], 
                "]"}], "]"}]}], "}"}], ",", 
            RowBox[{"Alignment", "->", "Center"}]}], "]"}]}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"3.", " ", "Vectorized", " ", 
         RowBox[{"Math", ":", 
          RowBox[{"Construct", " ", "o1", 
           RowBox[{"(", "y", ")"}], " ", "via", " ", "array", " ", 
           "broadcasting"}]}]}], "*)"}], 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{
         "This", " ", "multiplies", " ", "each", " ", "coefficient", " ", 
          "in", " ", "o1List", " ", "by", " ", "its", " ", "corresponding", " ",
           "uPower", " ", "row"}], ",", 
         RowBox[{"then", " ", "sums", " ", "them"}]}], "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"o1y", "=", 
        RowBox[{"Total", "[", 
         RowBox[{"o1List", "*", 
          RowBox[{"uPowers", "[", 
           RowBox[{"[", 
            RowBox[{"1", ";;", 
             RowBox[{"Length", "[", "o1List", "]"}]}], "]"}], "]"}]}], 
         "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"Cube", " ", "o1", 
         RowBox[{"(", "y", ")"}]}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{"o1sq", "=", 
        RowBox[{"convTruncFast", "[", 
         RowBox[{"o1y", ",", "o1y", ",", "nmax"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"o1cube", "=", 
        RowBox[{"convTruncFast", "[", 
         RowBox[{"o1sq", ",", "o1y", ",", "nmax"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
        "4.", " ", "Vectorized", " ", "Prefactor", " ", "Construction"}], 
        "*)"}], "\[IndentingNewLine]", 
       RowBox[{"prefCoeffs", "=", 
        RowBox[{"{", 
         RowBox[{"1", ",", 
          RowBox[{
           RowBox[{"-", "1"}], "/", "8"}], ",", 
          RowBox[{"63", "/", "64"}], ",", 
          RowBox[{"1377", "/", "512"}]}], "}"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"pref", "=", 
        RowBox[{"Total", "[", 
         RowBox[{"prefCoeffs", "*", 
          RowBox[{"uPowers", "[", 
           RowBox[{"[", 
            RowBox[{"1", ";;", "4"}], "]"}], "]"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"Final", " ", "truncated", " ", "convolution"}], "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"convTruncFast", "[", 
        RowBox[{"pref", ",", "o1cube", ",", "nmax"}], "]"}]}]}], 
     "]"}]}]}]}]], "Input",
