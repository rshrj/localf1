          "\[IndentingNewLine]", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"Abs", "[", 
              RowBox[{"z", "+", 
               RowBox[{"1", "/", "5"}]}], "]"}], "<", 
             RowBox[{"1", "/", "5"}]}], "&&", 
            RowBox[{
             RowBox[{"Abs", "[", "z", "]"}], "<", 
             RowBox[{"1", "/", "5"}]}]}], ",", 
           RowBox[{"AppendTo", "[", 
            RowBox[{"pts", ",", "z"}], "]"}]}], "]"}], ";"}]}], "]"}], ";", 
      "\[IndentingNewLine]", "pts"}]}], "]"}]}], ";"}]], "Input",
