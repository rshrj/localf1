Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{"convTrunc", ",", "convTruncFast"}], "]"}], ";"}], 
  "\[IndentingNewLine]", "\n", 
  RowBox[{"(*", 
   RowBox[{"Fixed", " ", "Procedural", " ", "Version"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"convTrunc", "[", 
    RowBox[{"a_List", ",", "b_List", ",", "nmax_Integer"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"la", "=", 
        RowBox[{"Length", "[", "a", "]"}]}], ",", 
       RowBox[{"lb", "=", 
        RowBox[{"Length", "[", "b", "]"}]}], ",", "len", ",", "res", ",", "i",
        ",", "j", ",", "ai"}], "}"}], ",", 
     RowBox[{
      RowBox[{"len", "=", 
       RowBox[{"Min", "[", 
        RowBox[{
         RowBox[{"nmax", "+", "1"}], ",", 
         RowBox[{"la", "+", "lb", "-", "1"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"res", "=", 
       RowBox[{"ConstantArray", "[", 
        RowBox[{"0", ",", "len"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"For", "[", 
       RowBox[{
        RowBox[{"i", "=", "1"}], ",", 
        RowBox[{"i", "<=", 
         RowBox[{"Min", "[", 
          RowBox[{"la", ",", "len"}], "]"}]}], ",", 
        RowBox[{"i", "++"}], ",", 
        RowBox[{
         RowBox[{"ai", "=", 
          RowBox[{"a", "[", 
           RowBox[{"[", "i", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"ai", "=!=", "0"}], ",", 
           RowBox[{
            RowBox[{"For", "[", 
             RowBox[{
              RowBox[{"j", "=", "1"}], ",", 
              RowBox[{"j", "<=", 
               RowBox[{"Min", "[", 
                RowBox[{"lb", ",", 
                 RowBox[{"len", "-", "i", "+", "1"}]}], "]"}]}], ",", 
              RowBox[{"j", "++"}], ",", 
              RowBox[{
               RowBox[{
                RowBox[{"res", "[", 
                 RowBox[{"[", 
                  RowBox[{"i", "+", "j", "-", "1"}], "]"}], "]"}], "+=", 
                RowBox[{"ai", " ", 
                 RowBox[{"b", "[", 
                  RowBox[{"[", "j", "]"}], "]"}]}]}], ";"}]}], "]"}], ";"}]}],
           "]"}], ";"}]}], "]"}], ";", "\[IndentingNewLine]", "res"}]}], 
    "]"}]}], "\[IndentingNewLine]", "\n", 
  RowBox[{"(*", 
   RowBox[{"Idiomatic", " ", "Fast", " ", "Version"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"convTruncFast", "[", 
   RowBox[{"a_List", ",", "b_List", ",", "nmax_Integer"}], "]"}], ":=", 
  RowBox[{"Take", "[", 
   RowBox[{
    RowBox[{"ListConvolve", "[", 
     RowBox[{"a", ",", "b", ",", 
      RowBox[{"{", 
       RowBox[{"1", ",", 
        RowBox[{"-", "1"}]}], "}"}], ",", "0"}], "]"}], ",", 
    RowBox[{"UpTo", "[", 
     RowBox[{"Max", "[", 
      RowBox[{"0", ",", 
       RowBox[{"nmax", "+", "1"}]}], "]"}], "]"}]}], "]"}]}]}], "Input",
 CellGroupingRules->{"GroupTogetherGrouping", 10000.},
 CellChangeTimes->{{3.983854021154121*^9, 3.983854032732398*^9}, 
   3.983854649580873*^9, {3.9838547090663033`*^9, 3.983854719412631*^9}},
 CellLabel->
  "In[107]:=",ExpressionUUID->"9c501652-da8b-4c17-9b4e-afeac1522854"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"testCases", "=", 
    RowBox[{"{", "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"List", " ", "A"}], ",", 
        RowBox[{"List", " ", "B"}], ",", "nmax", ",", 
        RowBox[{"Expected", " ", "Result"}], ",", 
        RowBox[{"Test", " ", "Description"}]}], "}"}], "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{"1.", " ", "Standard", " ", "Full", " ", "Convolution"}], 
      "*)"}], "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1", ",", "2", ",", "3"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"4", ",", "5", ",", "6"}], "}"}], ",", "5", ",", 
        RowBox[{"{", 
         RowBox[{"4", ",", "13", ",", "28", ",", "27", ",", "18"}], "}"}], 
        ",", "\"\<Standard full convolution\>\""}], "}"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"2.", " ", "Truncated", " ", "Convolution"}], "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1", ",", "2", ",", "3"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"4", ",", "5", ",", "6"}], "}"}], ",", "2", ",", 
        RowBox[{"{", 
         RowBox[{"4", ",", "13", ",", "28"}], "}"}], 
        ",", "\"\<Truncated to nmax=2\>\""}], "}"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"3.", " ", "Asymmetric", " ", "Lists"}], "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1", ",", "2"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"3", ",", "4", ",", "5", ",", "6"}], "}"}], ",", "10", ",", 
        RowBox[{"{", 
         RowBox[{"3", ",", "10", ",", "13", ",", "16", ",", "12"}], "}"}], 
        ",", "\"\<Asymmetric lengths\>\""}], "}"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"4.", " ", "Empty", " ", "List", " ", "Edge", " ", "Case"}], 
       "*)"}], "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", "2", ",", "3"}], "}"}], ",", "2", ",", 
        RowBox[{"{", "}"}], ",", "\"\<Empty first list\>\""}], "}"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1", ",", "2"}], "}"}], ",", 
        RowBox[{"{", "}"}], ",", "2", ",", 
        RowBox[{"{", "}"}], ",", "\"\<Empty second list\>\""}], "}"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"5.", " ", "Negative", " ", "nmax", " ", "Edge", " ", "Case"}],
        "*)"}], "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1", ",", "2"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"3", ",", "4"}], "}"}], ",", 
        RowBox[{"-", "1"}], ",", 
        RowBox[{"{", "}"}], ",", "\"\<Negative nmax yields empty list\>\""}], 
       "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"6.", " ", "Exact", " ", "Zeros", " ", "and", " ", "Floats"}], 
       "*)"}], "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1.", ",", "0.", ",", "2."}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"0.", ",", "3.", ",", "0."}], "}"}], ",", "5", ",", 
        RowBox[{"{", 
         RowBox[{"0.", ",", "3.", ",", "0.", ",", "6.", ",", "0."}], "}"}], 
        ",", "\"\<Floating point numbers and zeros\>\""}], "}"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"7.", " ", "Symbolic", " ", "Mathematics"}], "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"x", ",", "y"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"u", ",", "v"}], "}"}], ",", "1", ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"u", " ", "x"}], ",", 
          RowBox[{
           RowBox[{"u", " ", "y"}], "+", 
           RowBox[{"v", " ", "x"}]}]}], "}"}], 
        ",", "\"\<Symbolic variables\>\""}], "}"}]}], "}"}]}], ";"}], 
  "\[IndentingNewLine]", "\n", 
  RowBox[{"(*", 
   RowBox[{
   "Run", " ", "the", " ", "tests", " ", "and", " ", "generate", " ", "a", " ",
     "report"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
