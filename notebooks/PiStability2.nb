Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"sampleDU", "[", "n_", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"pts", "=", 
        RowBox[{"{", "}"}]}], ",", "z"}], "}"}], ",", 
     RowBox[{
      RowBox[{"While", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Length", "[", "pts", "]"}], "<", "n"}], ",", 
        RowBox[{
         RowBox[{"z", "=", 
          RowBox[{"RandomComplex", "[", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{
              RowBox[{"(", 
