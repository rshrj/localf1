Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Options", "[", "ComputeTransition2Primitive", "]"}], "=", 
   RowBox[{"{", 
    RowBox[{"WorkingPrecision", "->", "60"}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"ComputeTransition2Primitive", "[", 
    RowBox[{"el_", ",", "upath_", ",", 
     RowBox[{"Nn_", ":", "512"}], ",", 
     RowBox[{"Nr_", ":", "5"}], ",", 
     RowBox[{"OptionsPattern", "[", "]"}]}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"sol", ",", "Psi0", ",", " ", "Psi", ",", "mon", ",", "msg", ",", 
       RowBox[{"tt", "=", "0"}]}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{"Monitor", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"msg", "=", "\"\<Solving for the system matrix...\>\""}], ";",
         "\[IndentingNewLine]", 
        RowBox[{"Psi0", "=", 
         RowBox[{"SystemMatrix2", "[", 
          RowBox[{
           RowBox[{"F1Series2", "[", 
            RowBox[{"el", ",", 
             RowBox[{"upath", "[", "0", "]"}], ",", "Nn", ",", "Nr"}], "]"}], 
           ",", "el", ",", 
           RowBox[{"upath", "[", "0", "]"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"msg", "=", "\"\<Integrating the connection...\>\""}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"sol", "=", 
         RowBox[{"NDSolve", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"Psi", "'"}], "[", "t", "]"}], "==", 
              RowBox[{
               RowBox[{
                RowBox[{"upath", "'"}], "[", "t", "]"}], "*", 
               RowBox[{
                RowBox[{"PicardFuchsA2", "[", 
                 RowBox[{"el", ",", 
                  RowBox[{"upath", "[", "t", "]"}]}], "]"}], ".", 
                RowBox[{"Psi", "[", "t", "]"}]}]}]}], ",", 
             RowBox[{
              RowBox[{"Psi", "[", "0", "]"}], "==", "Psi0"}]}], "}"}], ",", 
           "Psi", ",", 
           RowBox[{"{", 
            RowBox[{"t", ",", "0", ",", "1"}], "}"}], ",", 
           RowBox[{"WorkingPrecision", "->", 
            RowBox[{"OptionValue", "[", "WorkingPrecision", "]"}]}], ",", 
           RowBox[{"MaxSteps", "->", 
            RowBox[{"10", "^", "7"}]}], ",", 
           RowBox[{"StepMonitor", ":>", 
            RowBox[{"(", 
             RowBox[{"tt", "=", "t"}], ")"}]}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"Psi", "[", "1", "]"}], "/.", " ", 
         RowBox[{"First", "[", "sol", "]"}]}]}], ",", "\[IndentingNewLine]", 
       RowBox[{"msg", "<>", "\"\< \>\"", "<>", 
        RowBox[{"ToString", "[", 
         RowBox[{"Floor", "[", 
          RowBox[{"100", " ", "tt"}], "]"}], "]"}], "<>", "\"\<%.\>\""}]}], 
      "]"}]}], "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.979728433128689*^9, 3.979728517189013*^9}},
 CellLabel->"In[99]:=",ExpressionUUID->"2f1ab776-790e-4470-aae6-f7ed367ffdc9"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Options", "[", "ComputeTransition2", "]"}], "=", 
   RowBox[{"{", 
