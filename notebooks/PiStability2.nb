    RowBox[{"Print", "[", 
     RowBox[{"\"\<Benchmarking lists of size \>\"", ",", "size", 
      ",", "\"\<...\>\""}], "]"}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Time", " ", "the", " ", "Fast", " ", "Version"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"timeFast", "=", 
     RowBox[{"First", "@", 
      RowBox[{"AbsoluteTiming", "[", 
       RowBox[{
        RowBox[{"res2", "=", 
         RowBox[{"convTruncFast", "[", 
          RowBox[{"listA", ",", "listB", ",", "nmaxLimit"}], "]"}]}], ";"}], 
       "]"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Fast version time: \>\"", ",", "timeFast", 
      ",", "\"\< seconds\>\""}], "]"}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Time", " ", "the", " ", "Procedural", " ", "Version"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"timeProcedural", "=", 
     RowBox[{"First", "@", 
      RowBox[{"AbsoluteTiming", "[", 
       RowBox[{
