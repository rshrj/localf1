 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Generate", " ", "large", " ", "random", " ", "lists"}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"SeedRandom", "[", "42", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"size", "=", "5000"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"listA", "=", 
     RowBox[{"RandomReal", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", "1"}], ",", "1"}], "}"}], ",", "size"}], "]"}]}], ";"}],
