Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "QuiverPlot", "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"QuiverPlot", "[", 
   RowBox[{"dsz_", "?", "MatrixQ"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"n", "=", 
       RowBox[{"Length", "[", "dsz", "]"}]}], ",", "edges"}], "}"}], ",", 
    RowBox[{
     RowBox[{"edges", "=", 
      RowBox[{"Flatten", "@", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"Which", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"dsz", "[", 
             RowBox[{"[", 
              RowBox[{"i", ",", "j"}], "]"}], "]"}], ">", "0"}], ",", 
           RowBox[{"ConstantArray", "[", 
            RowBox[{
             RowBox[{"DirectedEdge", "[", 
              RowBox[{"i", ",", "j"}], "]"}], ",", 
             RowBox[{"dsz", "[", 
              RowBox[{"[", 
               RowBox[{"i", ",", "j"}], "]"}], "]"}]}], "]"}], ",", 
           RowBox[{
            RowBox[{"dsz", "[", 
             RowBox[{"[", 
              RowBox[{"i", ",", "j"}], "]"}], "]"}], "<", "0"}], ",", 
           RowBox[{"ConstantArray", "[", 
            RowBox[{
             RowBox[{"DirectedEdge", "[", 
              RowBox[{"j", ",", "i"}], "]"}], ",", 
             RowBox[{"-", 
              RowBox[{"dsz", "[", 
               RowBox[{"[", 
                RowBox[{"i", ",", "j"}], "]"}], "]"}]}]}], "]"}], ",", "True",
            ",", 
           RowBox[{"{", "}"}]}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "n"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"j", ",", 
           RowBox[{"i", "+", "1"}], ",", "n"}], "}"}]}], "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Graph", "[", 
      RowBox[{
       RowBox[{"Range", "[", "n", "]"}], ",", "edges", ",", 
       RowBox[{"VertexLabels", "->", "\"\<Name\>\""}], ",", 
       RowBox[{"GraphLayout", "->", "\"\<CircularEmbedding\>\""}], ",", 
       RowBox[{"EdgeLabels", "->", 
        RowBox[{"(", 
         RowBox[{"e_", ":>", 
          RowBox[{"Length", "@", 
           RowBox[{"Cases", "[", 
            RowBox[{"edges", ",", "e"}], "]"}]}]}], ")"}]}], ",", 
       RowBox[{"EdgeStyle", "->", 
        RowBox[{"Arrowheads", "[", "0.1", "]"}]}], ",", 
       RowBox[{"VertexSize", "->", "Small"}], ",", 
       RowBox[{"ImageSize", "->", "Small"}]}], "]"}]}]}], "]"}]}]}], "Input",
 CellChangeTimes->{{3.99077578139468*^9, 3.990775781396193*^9}, {
