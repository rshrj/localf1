Cell["mutation classes", "Section",
 CellChangeTimes->{{3.991017309529665*^9, 
  3.991017311615409*^9}},ExpressionUUID->"5039c7fb-fa56-4e5d-92e0-\
963791978d72"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{"mutateB", ",", "mutationClass", ",", "arrows"}], "]"}], ";"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"mutateB", "[", 
     RowBox[{"B_", ",", "k_Integer"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"n", "=", 
        RowBox[{"Length", "[", "B", "]"}]}], "}"}], ",", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"i", "==", "k"}], "||", 
           RowBox[{"j", "==", "k"}]}], ",", 
          RowBox[{"-", 
           RowBox[{"B", "[", 
            RowBox[{"[", 
             RowBox[{"i", ",", "j"}], "]"}], "]"}]}], ",", 
          RowBox[{
           RowBox[{"B", "[", 
            RowBox[{"[", 
             RowBox[{"i", ",", "j"}], "]"}], "]"}], "+", 
           RowBox[{
            RowBox[{"Max", "[", 
             RowBox[{
              RowBox[{"B", "[", 
               RowBox[{"[", 
                RowBox[{"i", ",", "k"}], "]"}], "]"}], ",", "0"}], "]"}], " ", 
            RowBox[{"Max", "[", 
             RowBox[{
              RowBox[{"B", "[", 
               RowBox[{"[", 
                RowBox[{"k", ",", "j"}], "]"}], "]"}], ",", "0"}], "]"}]}], "-", 
           RowBox[{
            RowBox[{"Max", "[", 
             RowBox[{
              RowBox[{"-", 
               RowBox[{"B", "[", 
                RowBox[{"[", 
                 RowBox[{"i", ",", "k"}], "]"}], "]"}]}], ",", "0"}], "]"}], " ", 
            RowBox[{"Max", "[", 
             RowBox[{
              RowBox[{"-", 
               RowBox[{"B", "[", 
                RowBox[{"[", 
                 RowBox[{"k", ",", "j"}], "]"}], "]"}]}], ",", "0"}], 
             "]"}]}]}]}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "n"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"j", ",", "n"}], "}"}]}], "]"}]}], "]"}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"mutationClass", "[", "B0_", "]"}], ":=", 
    RowBox[{"FixedPoint", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"DeleteDuplicates", "@", 
        RowBox[{"Join", "[", 
         RowBox[{"#", ",", 
          RowBox[{"Flatten", "[", 
           RowBox[{
            RowBox[{"Table", "[", 
             RowBox[{
              RowBox[{"mutateB", "[", 
               RowBox[{"B", ",", "k"}], "]"}], ",", 
              RowBox[{"{", 
               RowBox[{"B", ",", "#"}], "}"}], ",", 
              RowBox[{"{", 
               RowBox[{"k", ",", 
                RowBox[{"Length", "[", "B0", "]"}]}], "}"}]}], "]"}], ",", 
            "1"}], "]"}]}], "]"}]}], "&"}], ",", 
      RowBox[{"{", "B0", "}"}]}], "]"}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"arrows", "[", "B_", "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"n", "=", 
        RowBox[{"Length", "[", "B", "]"}]}], "}"}], ",", 
      RowBox[{"Cases", "[", 
       RowBox[{
        RowBox[{"Flatten", "[", 
         RowBox[{
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"Which", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"B", "[", 
                RowBox[{"[", 
                 RowBox[{"i", ",", "j"}], "]"}], "]"}], ">", "0"}], ",", 
              RowBox[{"{", 
               RowBox[{"{", 
                RowBox[{"i", ",", "j", ",", 
                 RowBox[{"B", "[", 
                  RowBox[{"[", 
                   RowBox[{"i", ",", "j"}], "]"}], "]"}]}], "}"}], "}"}], ",", 
              RowBox[{
               RowBox[{"B", "[", 
                RowBox[{"[", 
                 RowBox[{"i", ",", "j"}], "]"}], "]"}], "<", "0"}], ",", 
              RowBox[{"{", 
               RowBox[{"{", 
                RowBox[{"j", ",", "i", ",", 
                 RowBox[{"-", 
                  RowBox[{"B", "[", 
                   RowBox[{"[", 
                    RowBox[{"i", ",", "j"}], "]"}], "]"}]}]}], "}"}], "}"}], ",",
               "True", ",", 
              RowBox[{"{", "}"}]}], "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"i", ",", "n"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"j", ",", 
              RowBox[{"i", "+", "1"}], ",", "n"}], "}"}]}], "]"}], ",", "2"}],
          "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"_Integer", ",", "_Integer", ",", "_Integer"}], "}"}]}], 
       "]"}]}], "]"}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"B0", "=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"0", ",", 
        RowBox[{"-", "2"}], ",", "1"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"2", ",", "0", ",", 
        RowBox[{"-", "1"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", "1"}], ",", "1", ",", "0"}], "}"}]}], "}"}]}], ";"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"cls", "=", 
    RowBox[{"mutationClass", "[", "B0", "]"}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{"Length", "[", "cls", "]"}], "\n", 
 RowBox[{"arrows", "/@", "cls"}]}], "Input",
