  InformationData[<|
   "ObjectType" -> "Symbol", "Usage" -> 
    "ConstructMcKayDiagram[phimax_,Nm_,m_,ListRays_] constructs the quiver \
scattering diagram by iteratively intersecting rays up to total height \
phimax, with Kronecker multiplicity cutoff Nm. If ListRays is {}, starts from \
the Length[Mat] initial simple-root rays; otherwise resumes from the given \
list. Supports CheckAbort for graceful interruption. Returns a list of \
entries {charge, {u,v}, parent1Index, parent2Index, mult1, mult2, level}.", 
    "Documentation" -> None, "OwnValues" -> None, "UpValues" -> None, 
    "DownValues" -> 
    Information`InformationValueForm[
     DownValues, SWNf1QuiverScattering`ConstructMcKayDiagram, {
      SWNf1QuiverScattering`ConstructMcKayDiagram[
         Pattern[SWNf1QuiverScattering`Private`phimax, 
          Blank[]], 
         Pattern[SWNf1QuiverScattering`Private`Nm, 
          Blank[]], 
         Pattern[SWNf1QuiverScattering`Private`m, 
          Blank[]], 
         Pattern[SWNf1QuiverScattering`Private`ListRays0, 
          Blank[]]] :> 
       Module[{SWNf1QuiverScattering`Private`ListRays, 
          SWNf1QuiverScattering`Private`seen, SWNf1QuiverScattering`Private`n,
           SWNf1QuiverScattering`Private`new, 
          SWNf1QuiverScattering`Private`kappa, 
          SWNf1QuiverScattering`Private`inter, 
          SWNf1QuiverScattering`Private`ktab, 
          SWNf1QuiverScattering`Private`nNodes}, 
         SWNf1QuiverScattering`Private`nNodes = 
          Length[SWNf1QuiverScattering`Mat]; 
         SWNf1QuiverScattering`Private`ListRays = 
          If[SWNf1QuiverScattering`Private`ListRays0 == {}, 
            Table[{
              Part[
               IdentityMatrix[SWNf1QuiverScattering`Private`nNodes], 
               SWNf1QuiverScattering`Private`k], Part[
                SWNf1QuiverScattering`InitialRaysOrigin[
                SWNf1QuiverScattering`Private`m], 
                SWNf1QuiverScattering`Private`k] - 5 
              SWNf1QuiverScattering`McKayVec[
                Part[
                 IdentityMatrix[SWNf1QuiverScattering`Private`nNodes], 
                 SWNf1QuiverScattering`Private`k]], 0, 0, 0, 0, 1}, {
             SWNf1QuiverScattering`Private`k, 
              SWNf1QuiverScattering`Private`nNodes}], 
            SWNf1QuiverScattering`Private`ListRays0]; 
         SWNf1QuiverScattering`Private`seen = AssociationThread[Select[
              Part[SWNf1QuiverScattering`Private`ListRays, All, {3, 4}], 
              First[#] > 0& ] -> True]; 
         CheckAbort[
          While[True, 
             SWNf1QuiverScattering`Private`n = 
              Length[SWNf1QuiverScattering`Private`ListRays]; 
             SWNf1QuiverScattering`Private`new = Part[
                Reap[
                 Do[
                  If[
                   Not[
                    KeyExistsQ[
                    SWNf1QuiverScattering`Private`seen, {
                    SWNf1QuiverScattering`Private`i, 
                    SWNf1QuiverScattering`Private`j}]], 
                   SWNf1QuiverScattering`Private`seen[{
                    SWNf1QuiverScattering`Private`i, 
                    SWNf1QuiverScattering`Private`j}] = True; 
                   SWNf1QuiverScattering`Private`kappa = 
                    SWNf1QuiverScattering`McKayDSZ[
                    Part[
                    SWNf1QuiverScattering`Private`ListRays, 
                    SWNf1QuiverScattering`Private`i, 1], 
                    Part[
                    SWNf1QuiverScattering`Private`ListRays, 
                    SWNf1QuiverScattering`Private`j, 1]]; 
                   If[SWNf1QuiverScattering`Private`kappa =!= 0, 
                    SWNf1QuiverScattering`Private`inter = 
                    SWNf1QuiverScattering`McKayIntersectRaysNoTest[
                    Part[
                    SWNf1QuiverScattering`Private`ListRays, 
                    SWNf1QuiverScattering`Private`i, 1], 
                    Part[
                    SWNf1QuiverScattering`Private`ListRays, 
                    SWNf1QuiverScattering`Private`j, 1], 
                    Part[
                    SWNf1QuiverScattering`Private`ListRays, 
                    SWNf1QuiverScattering`Private`i, 2], 
                    Part[
                    SWNf1QuiverScattering`Private`ListRays, 
                    SWNf1QuiverScattering`Private`j, 2], 
                    SWNf1QuiverScattering`Private`m]; 
                    If[SWNf1QuiverScattering`Private`inter =!= {}, 
                    SWNf1QuiverScattering`Private`ktab = 
                    SWNf1QuiverScattering`KroneckerDims[
                    Abs[SWNf1QuiverScattering`Private`kappa], 
                    SWNf1QuiverScattering`Private`Nm]; Do[
                    If[
                    Apply[Plus, 
                    Part[SWNf1QuiverScattering`Private`ktab, 
                    SWNf1QuiverScattering`Private`k, 1] 
                    Part[SWNf1QuiverScattering`Private`ListRays, 
                    SWNf1QuiverScattering`Private`i, 1] + 
                    Part[SWNf1QuiverScattering`Private`ktab, 
                    SWNf1QuiverScattering`Private`k, 2] 
                    Part[SWNf1QuiverScattering`Private`ListRays, 
                    SWNf1QuiverScattering`Private`j, 1]] <= 
                    SWNf1QuiverScattering`Private`phimax, 
                    
                    Sow[{Part[SWNf1QuiverScattering`Private`ktab, 
                    SWNf1QuiverScattering`Private`k, 1] 
                    Part[SWNf1QuiverScattering`Private`ListRays, 
                    SWNf1QuiverScattering`Private`i, 1] + 
                    Part[SWNf1QuiverScattering`Private`ktab, 
                    SWNf1QuiverScattering`Private`k, 2] 
                    Part[SWNf1QuiverScattering`Private`ListRays, 
                    SWNf1QuiverScattering`Private`j, 1], 
                    SWNf1QuiverScattering`Private`inter, 
                    SWNf1QuiverScattering`Private`i, 
                    SWNf1QuiverScattering`Private`j, 
                    Part[
                    SWNf1QuiverScattering`Private`ktab, 
                    SWNf1QuiverScattering`Private`k, 1], 
                    Part[
                    SWNf1QuiverScattering`Private`ktab, 
                    SWNf1QuiverScattering`Private`k, 2], 1 + Max[
                    Part[
                    SWNf1QuiverScattering`Private`ListRays, 
                    SWNf1QuiverScattering`Private`i, 7], 
                    Part[
                    SWNf1QuiverScattering`Private`ListRays, 
                    SWNf1QuiverScattering`Private`j, 7]]}]], {
                    SWNf1QuiverScattering`Private`k, 
                    Length[SWNf1QuiverScattering`Private`ktab]}]]]], {
                  SWNf1QuiverScattering`Private`i, 
                   SWNf1QuiverScattering`Private`n}, {
                  SWNf1QuiverScattering`Private`j, 
                   SWNf1QuiverScattering`Private`i + 1, 
                   SWNf1QuiverScattering`Private`n}]], 2]; 
             SWNf1QuiverScattering`Private`new = 
              If[SWNf1QuiverScattering`Private`new === {}, {}, 
                First[SWNf1QuiverScattering`Private`new]]; If[
               Or[
               SWNf1QuiverScattering`Private`new === {}, 
                SWNf1QuiverScattering`Private`new === Null], 
               Break[], Print["Adding ", 
                 Length[SWNf1QuiverScattering`Private`new], " rays, "]; 
               SWNf1QuiverScattering`Private`ListRays = 
                Join[SWNf1QuiverScattering`Private`ListRays, 
                  SWNf1QuiverScattering`Private`new]]]; Print[
             Length[SWNf1QuiverScattering`Private`ListRays], " in total."]; 
           SWNf1QuiverScattering`Private`ListRays, 
           Print["Aborted -- returning partial ListRays (", 
             Length[SWNf1QuiverScattering`Private`ListRays], ")."]; 
           SWNf1QuiverScattering`Private`ListRays]]}], "SubValues" -> None, 
    "DefaultValues" -> None, "NValues" -> None, "FormatValues" -> None, 
    "Options" -> None, "Attributes" -> {}, "FullName" -> 
    "SWNf1QuiverScattering`ConstructMcKayDiagram"|>, False]]], "Output",
 CellChangeTimes->{3.990779791069913*^9},
 CellLabel->
