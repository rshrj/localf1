Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"===", "===", "===", "===", "===", "===", "===", 
    RowBox[{"Map", " ", "to", " ", "\[Tau]", " ", "and", " ", "plot"}], "===",
     "===", "===", "===", "===", "===", "==="}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"\[Tau]", "[", "s_", "]"}], ":=", 
    RowBox[{
     RowBox[{"I", " ", 
      RowBox[{
       RowBox[{"EllipticK", "[", 
        RowBox[{"1", "-", 
         RowBox[{"modulus", "[", 
          RowBox[{
           RowBox[{"e1", "[", "s", "]"}], ",", 
           RowBox[{"e2", "[", "s", "]"}], ",", 
           RowBox[{"e3", "[", "s", "]"}]}], "]"}]}], "]"}], "/", 
