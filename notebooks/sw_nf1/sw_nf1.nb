Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"RichardsonResum", "[", 
    RowBox[{"PartSum_", ",", "n_"}], "]"}], ":=", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"d", "=", 
       RowBox[{
        RowBox[{"Length", "[", "PartSum", "]"}], "-", "n", "-", "1"}]}], 
      "}"}], ",", 
     RowBox[{"Sum", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"PartSum", "[", 
         RowBox[{"[", 
          RowBox[{
           RowBox[{"Length", "[", "PartSum", "]"}], "+", "k", "-", "n"}], 
          "]"}], "]"}], " ", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"d", "+", "k"}], ")"}], "^", "n"}], " ", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"-", "1"}], ")"}], "^", 
           RowBox[{"(", 
            RowBox[{"k", "+", "n"}], ")"}]}], "/", 
          RowBox[{"k", "!"}]}], "/", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"n", "-", "k"}], ")"}], "!"}]}]}], ",", 
       RowBox[{"{", 
        RowBox[{"k", ",", "0", ",", "n"}], "}"}]}], "]"}]}], "]"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.9908082874704723`*^9, 3.9908082874714613`*^9}},
 CellLabel->
  "In[253]:=",ExpressionUUID->"d11eb652-88cd-4b07-96c2-460dd8ab2bbe"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{"g2g3FromCoeffs", ",", "g2g3FromCubic"}], "]"}], ";"}], 
  "\[IndentingNewLine]", "\n", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"For", " ", 
     RowBox[{"y", "^", "2"}]}], "=", 
    RowBox[{
     RowBox[{"x", "^", "3"}], "+", 
     RowBox[{"a2", " ", 
      RowBox[{"x", "^", "2"}]}], "+", 
     RowBox[{"a1", " ", "x"}], "+", "a0"}]}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"g2g3FromCoeffs", "[", 
     RowBox[{"a2_", ",", "a1_", ",", "a0_"}], "]"}], ":=", 
    RowBox[{"Simplify", "[", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"g2", "->", 
        RowBox[{
         RowBox[{"4", "/", "3"}], " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"a2", "^", "2"}], "-", 
           RowBox[{"3", " ", "a1"}]}], ")"}]}]}], ",", 
       RowBox[{"g3", "->", 
        RowBox[{
         RowBox[{"4", "/", "27"}], " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"9", " ", "a1", " ", "a2"}], "-", 
           RowBox[{"27", " ", "a0"}], "-", 
           RowBox[{"2", " ", 
            RowBox[{"a2", "^", "3"}]}]}], ")"}]}]}]}], "}"}], "]"}]}], ";"}], 
  "\[IndentingNewLine]", "\n", 
  RowBox[{"(*", 
   RowBox[{
   "For", " ", "an", " ", "explicit", " ", "monic", " ", "cubic", " ", 
    "polynomial", " ", "in", " ", "x"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"g2g3FromCubic", "[", 
    RowBox[{"poly_", ",", "x_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"a2", ",", "a1", ",", "a0"}], "}"}], ",", 
     RowBox[{
      RowBox[{"a2", "=", 
       RowBox[{"Coefficient", "[", 
        RowBox[{"poly", ",", "x", ",", "2"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"a1", "=", 
       RowBox[{"Coefficient", "[", 
        RowBox[{"poly", ",", "x", ",", "1"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"a0", "=", 
       RowBox[{"Coefficient", "[", 
        RowBox[{"poly", ",", "x", ",", "0"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"g2g3FromCoeffs", "[", 
       RowBox[{"a2", ",", "a1", ",", "a0"}], "]"}]}]}], "]"}]}], 
  ";"}]}], "Input",
 CellChangeTimes->{{3.9905147455819397`*^9, 3.9905147455849447`*^9}},
 CellLabel->
  "In[628]:=",ExpressionUUID->"0e31922d-930e-4496-9762-ae87155186f1"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"QuarticInvariants", "[", 
    RowBox[{"poly_", ",", "x_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "a", ",", "b", ",", "c", ",", "d", ",", "e", ",", "I", ",", "J", ",", 
       "coeffs"}], "}"}], ",", 
     RowBox[{
      RowBox[{"coeffs", "=", 
       RowBox[{"CoefficientList", "[", 
        RowBox[{"poly", ",", "x"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"e", ",", "d", ",", "c", ",", "b", ",", "a"}], "}"}], "=", 
       RowBox[{"PadRight", "[", 
        RowBox[{"coeffs", ",", "5"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"I", "=", 
       RowBox[{
        RowBox[{"12", " ", "a", " ", "e"}], "-", 
        RowBox[{"3", " ", "b", " ", "d"}], "+", 
        RowBox[{"c", "^", "2"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"J", "=", 
       RowBox[{
        RowBox[{"72", " ", "a", " ", "c", " ", "e"}], "+", 
        RowBox[{"9", " ", "b", " ", "c", " ", "d"}], "-", 
        RowBox[{"27", " ", "a", " ", 
         RowBox[{"d", "^", "2"}]}], "-", 
        RowBox[{"27", " ", 
         RowBox[{"b", "^", "2"}], " ", "e"}], "-", 
        RowBox[{"2", " ", 
         RowBox[{"c", "^", "3"}]}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"\"\<I\>\"", "->", "I"}], ",", 
        RowBox[{"\"\<J\>\"", "->", "J"}], ",", 
        RowBox[{"\"\<Delta\>\"", "->", 
         RowBox[{
          RowBox[{"4", " ", 
           RowBox[{"I", "^", "3"}]}], "-", 
          RowBox[{"J", "^", "2"}]}]}]}], "|>"}]}]}], "]"}]}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"QuarticjInvariant", "[", 
    RowBox[{"poly_", ",", "x_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"inv", ",", "I", ",", "J"}], "}"}], ",", 
     RowBox[{
      RowBox[{"inv", "=", 
       RowBox[{"QuarticInvariants", "[", 
        RowBox[{"poly", ",", "x"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"I", "=", 
       RowBox[{"inv", "[", "\"\<I\>\"", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"J", "=", 
       RowBox[{"inv", "[", "\"\<J\>\"", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"FullSimplify", "[", 
       RowBox[{"1728", " ", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"4", " ", 
           RowBox[{"I", "^", "3"}]}], ")"}], "/", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"4", " ", 
            RowBox[{"I", "^", "3"}]}], "-", 
           RowBox[{"J", "^", "2"}]}], ")"}]}]}], "]"}]}]}], "]"}]}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"QuarticKleinInvariant", "[", 
   RowBox[{"poly_", ",", "x_"}], "]"}], ":=", 
  RowBox[{"FullSimplify", "[", 
   RowBox[{
    RowBox[{"QuarticjInvariant", "[", 
     RowBox[{"poly", ",", "x"}], "]"}], "/", "1728"}], "]"}]}]}], "Input",
 CellChangeTimes->{{3.990858551423628*^9, 3.9908585514250793`*^9}},
 CellLabel->
  "In[635]:=",ExpressionUUID->"9b1a1cdc-108a-42a8-8eb5-d9f1cabd6f44"],

