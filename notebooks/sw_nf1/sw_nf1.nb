    RowBox[{"rp", "[", "\"\<Curve\>\"", "]"}], "[", "\[ScriptL]", "]"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.990595746191205*^9, 3.990595770069086*^9}},
