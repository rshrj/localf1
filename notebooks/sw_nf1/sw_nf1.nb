Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "ArcLengthReparametrize", "]"}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ArcLengthReparametrize", "[", 
   RowBox[{"f_", ",", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"smin_", "?", "NumericQ"}], ",", 
      RowBox[{"smax_", "?", "NumericQ"}]}], "}"}], ",", 
    RowBox[{"n_Integer", ":", "10000"}], ",", 
    RowBox[{"metric_", ":", "\"\<Euclidean\>\""}]}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "sGrid", ",", "zGrid", ",", "increments", ",", "lengthGrid", ",", 
      "tolerance", ",", "keep", ",", "sOfLength", ",", "totalLength"}], "}"}],
     ",", 
    RowBox[{
     RowBox[{"sGrid", "=", 
      RowBox[{"Subdivide", "[", 
       RowBox[{
        RowBox[{"N", "[", "smin", "]"}], ",", 
        RowBox[{"N", "[", "smax", "]"}], ",", "n"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"zGrid", "=", 
      RowBox[{"f", "/@", "sGrid"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"!", 
        RowBox[{"VectorQ", "[", 
         RowBox[{"zGrid", ",", "NumericQ"}], "]"}]}], ",", 
       RowBox[{
        RowBox[{
        "Print", 
         "[", "\"\<The function did not return numerical values everywhere.\>\
\"", "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"Return", "[", "$Failed", "]"}]}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"increments", "=", 
      RowBox[{"Switch", "[", 
       RowBox[{"metric", ",", "\"\<Euclidean\>\"", ",", 
        RowBox[{"Abs", "[", 
         RowBox[{"Differences", "[", "zGrid", "]"}], "]"}], 
        ",", "\"\<Hyperbolic\>\"", ",", 
        RowBox[{
         RowBox[{"Abs", "[", 
          RowBox[{"Differences", "[", "zGrid", "]"}], "]"}], "/", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"Im", "[", 
              RowBox[{"Most", "[", "zGrid", "]"}], "]"}], "+", 
             RowBox[{"Im", "[", 
              RowBox[{"Rest", "[", "zGrid", "]"}], "]"}]}], ")"}], "/", "2"}],
           ")"}]}], ",", "_", ",", 
        RowBox[{
         RowBox[{
         "Print", 
          "[", "\"\<Metric must be \\\"Euclidean\\\" or \\\"Hyperbolic\\\".\>\
\"", "]"}], ";", "\[IndentingNewLine]", 
         RowBox[{"Return", "[", "$Failed", "]"}]}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"lengthGrid", "=", 
      RowBox[{"Prepend", "[", 
       RowBox[{
        RowBox[{"Accumulate", "[", "increments", "]"}], ",", "0."}], "]"}]}], 
     ";", "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
      "Remove", " ", "numerically", " ", "stationary", " ", "points", " ", 
       "so", " ", "that", " ", "inversion", " ", "is", " ", "possible"}], 
      "*)"}], 
     RowBox[{"tolerance", "=", 
      RowBox[{
       RowBox[{"10", "^", 
        RowBox[{"-", "12"}]}], " ", 
       RowBox[{"Max", "[", 
        RowBox[{"1.", ",", 
         RowBox[{"Last", "[", "lengthGrid", "]"}]}], "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"keep", "=", 
      RowBox[{"Prepend", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Flatten", "[", 
          RowBox[{"Position", "[", 
           RowBox[{
            RowBox[{"Differences", "[", "lengthGrid", "]"}], ",", 
            RowBox[{"x_", "/;", 
             RowBox[{"x", ">", "tolerance"}]}]}], "]"}], "]"}], "+", "1"}], ",",
         "1"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"keep", "=", 
      RowBox[{"DeleteDuplicates", "[", "keep", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"sOfLength", "=", 
      RowBox[{"Interpolation", "[", 
       RowBox[{
        RowBox[{"Transpose", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"lengthGrid", "[", 
            RowBox[{"[", "keep", "]"}], "]"}], ",", 
           RowBox[{"sGrid", "[", 
            RowBox[{"[", "keep", "]"}], "]"}]}], "}"}], "]"}], ",", 
        RowBox[{"InterpolationOrder", "->", "1"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"totalLength", "=", 
      RowBox[{"Last", "[", 
       RowBox[{"lengthGrid", "[", 
        RowBox[{"[", "keep", "]"}], "]"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<TotalLength\>\"", "->", "totalLength"}], ",", 
       RowBox[{"\"\<OriginalParameter\>\"", "->", "sOfLength"}], ",", 
       RowBox[{"\"\<Curve\>\"", "->", 
        RowBox[{"Function", "[", 
         RowBox[{
          RowBox[{"{", "\[ScriptL]", "}"}], ",", 
          RowBox[{"f", "[", 
           RowBox[{"sOfLength", "[", "\[ScriptL]", "]"}], "]"}]}], "]"}]}]}], 
      "|>"}]}]}], "]"}]}]}], "Input",
 CellChangeTimes->{{3.990595716991416*^9, 3.990595716994446*^9}},
 CellLabel->
  "In[616]:=",ExpressionUUID->"adf19d37-8224-4411-861c-2187f0cd7b7e"],

Cell[BoxData[
 RowBox[{
  RowBox[{"rp", "=", 
   RowBox[{"ArcLengthReparametrize", "[", 
    RowBox[{"\[Tau]", ",", 
     RowBox[{"{", 
      RowBox[{"0", ",", "smax"}], "}"}], ",", "20000", 
     ",", "\"\<Hyperbolic\>\""}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.99059572354673*^9, 3.99059573552884*^9}},
